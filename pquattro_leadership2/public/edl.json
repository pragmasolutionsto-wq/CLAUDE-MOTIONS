 "cues": [
  {
   "text": "Hai mai sperimentato la difficoltà a fare le",
   "t": 0.09,
   "te": 2.38
  },
  {
   "text": "cose che andrebbero fatte o a farle nel",
   "t": 2.38,
   "te": 4.64
  },
  {
   "text": "modo giusto?",
   "t": 4.64,
   "te": 5.5
  },
  {
   "text": "Sai cosa dovresti fare?",
   "t": 5.88,
   "te": 7.35
  },
  {
   "text": "Ma qualcosa dentro ti tiene fermo, anche quando",
   "t": 7.17,
   "te": 11.08
  },
  {
   "text": "vorresti muoverti.",
   "t": 11.08,
   "te": 12.22
  },
  {
   "text": "La verità è che i risultati non arrivano",
   "t": 12.7,
   "te": 14.69
  },
  {
   "text": "da soli, bisogna fare delle cose, ma prima",
   "t": 14.69,
   "te": 17.27
  },
  {
   "text": "ancora di farle bisogna essere qualcosa di diverso",
   "t": 17.27,
   "te": 20.13
  },
  {
   "text": "rispetto al passato.",
   "t": 20.13,
   "te": 21.26
  },
  {
   "text": "Se vuoi ottenere ciò che non hai mai",
   "t": 21.69,
   "te": 23.47
  },
  {
   "text": "ottenuto, devi fare ciò che non hai mai",
   "t": 23.47,
   "te": 26.07
  },
  {
   "text": "fatto, e per fare ciò che non hai",
   "t": 26.07,
   "te": 27.989
  },
  {
   "text": "mai fatto devi essere chi non sei mai",
   "t": 27.989,
   "te": 30.87
  },
  {
   "text": "stato.",
   "t": 30.87,
   "te": 31.33
  },
  {
   "text": "Da titolare di farmacia al leader che ispira,",
   "t": 32.1,
   "te": 34.79
  },
  {
   "text": "il percorso per essere prima ancora di fare.",
   "t": 34.7,
   "te": 37.78
  },
  {
   "text": "Scopri di più cliccando il link.",
   "t": 38.21,
   "te": 40.0
  }
 ],

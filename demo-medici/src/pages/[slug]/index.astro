---
import HomeMedico from '../../layouts/HomeMedico.astro';
import HomeClinica from '../../layouts/HomeClinica.astro';
import HomeLaterale from '../../layouts/HomeLaterale.astro';
import HomeStudio from '../../layouts/HomeStudio.astro';
import HomeRecensioni from '../../layouts/HomeRecensioni.astro';
import HomeCasistica from '../../layouts/HomeCasistica.astro';
import HomeInterventi from '../../layouts/HomeInterventi.astro';
import HomeRivista from '../../layouts/HomeRivista.astro';
import HomeCinetica from '../../layouts/HomeCinetica.astro';
import HomeBattito from '../../layouts/HomeBattito.astro';
import HomeDomicilio from '../../layouts/HomeDomicilio.astro';
import HomeVisus from '../../layouts/HomeVisus.astro';
import HomeEta from '../../layouts/HomeEta.astro';
import HomeSala from '../../layouts/HomeSala.astro';
import HomeProfilo from '../../layouts/HomeProfilo.astro';
import HomeAscolto from '../../layouts/HomeAscolto.astro';
import HomePercorso from '../../layouts/HomePercorso.astro';
import HomeOncologia from '../../layouts/HomeOncologia.astro';
import HomeMovimento from '../../layouts/HomeMovimento.astro';
import HomeTrattato from '../../layouts/HomeTrattato.astro';
import HomeLente from '../../layouts/HomeLente.astro';
import HomeDonna from '../../layouts/HomeDonna.astro';
import HomeSpirale from '../../layouts/HomeSpirale.astro';
import HomePlacido from '../../layouts/HomePlacido.astro';
import { medici, type Medico } from '../../lib/medici';

export function getStaticPaths() {
  return medici.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Medico };
---
{(m as any).layout === 'clinica' ? <HomeClinica m={m} /> : (m as any).layout === 'laterale' ? <HomeLaterale m={m} /> : (m as any).layout === 'studio' ? <HomeStudio m={m} /> : (m as any).layout === 'recensioni' ? <HomeRecensioni m={m} /> : (m as any).layout === 'casistica' ? <HomeCasistica m={m} /> : (m as any).layout === 'interventi' ? <HomeInterventi m={m} /> : (m as any).layout === 'rivista' ? <HomeRivista m={m} /> : (m as any).layout === 'cinetica' ? <HomeCinetica m={m} /> : (m as any).layout === 'battito' ? <HomeBattito m={m} /> : (m as any).layout === 'domicilio' ? <HomeDomicilio m={m} /> : (m as any).layout === 'visus' ? <HomeVisus m={m} /> : (m as any).layout === 'eta' ? <HomeEta m={m} /> : (m as any).layout === 'sala' ? <HomeSala m={m} /> : (m as any).layout === 'profilo' ? <HomeProfilo m={m} /> : (m as any).layout === 'ascolto' ? <HomeAscolto m={m} /> : (m as any).layout === 'percorso' ? <HomePercorso m={m} /> : (m as any).layout === 'oncologia' ? <HomeOncologia m={m} /> : (m as any).layout === 'movimento' ? <HomeMovimento m={m} /> : (m as any).layout === 'trattato' ? <HomeTrattato m={m} /> : (m as any).layout === 'lente' ? <HomeLente m={m} /> : (m as any).layout === 'donna' ? <HomeDonna m={m} /> : (m as any).layout === 'spirale' ? <HomeSpirale m={m} /> : (m as any).layout === 'placido' ? <HomePlacido m={m} /> : <HomeMedico m={m} />}

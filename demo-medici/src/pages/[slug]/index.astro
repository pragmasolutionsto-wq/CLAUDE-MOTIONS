---
import HomeMedico from '../../layouts/HomeMedico.astro';
import HomeClinica from '../../layouts/HomeClinica.astro';
import HomeLaterale from '../../layouts/HomeLaterale.astro';
import HomeStudio from '../../layouts/HomeStudio.astro';
import HomeRecensioni from '../../layouts/HomeRecensioni.astro';
import HomeCasistica from '../../layouts/HomeCasistica.astro';
import HomeInterventi from '../../layouts/HomeInterventi.astro';
import HomeRivista from '../../layouts/HomeRivista.astro';
import HomeCinetica from '../../layouts/HomeCinetica.astro';
import HomeBattito from '../../layouts/HomeBattito.astro';
import HomeDomicilio from '../../layouts/HomeDomicilio.astro';
import { medici, type Medico } from '../../lib/medici';

export function getStaticPaths() {
  return medici.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Medico };
---
{(m as any).layout === 'clinica' ? <HomeClinica m={m} /> : (m as any).layout === 'laterale' ? <HomeLaterale m={m} /> : (m as any).layout === 'studio' ? <HomeStudio m={m} /> : (m as any).layout === 'recensioni' ? <HomeRecensioni m={m} /> : (m as any).layout === 'casistica' ? <HomeCasistica m={m} /> : (m as any).layout === 'interventi' ? <HomeInterventi m={m} /> : (m as any).layout === 'rivista' ? <HomeRivista m={m} /> : (m as any).layout === 'cinetica' ? <HomeCinetica m={m} /> : (m as any).layout === 'battito' ? <HomeBattito m={m} /> : (m as any).layout === 'domicilio' ? <HomeDomicilio m={m} /> : <HomeMedico m={m} />}

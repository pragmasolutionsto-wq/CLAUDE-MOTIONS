---
// Indice del blog (solo per i medici che hanno "blog" nel JSON)
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Icona from '../../../components/Icona.astro';
import CtaFinale from '../../../components/CtaFinale.astro';
import CtaMobile from '../../../components/CtaMobile.astro';
import Footer from '../../../components/Footer.astro';
import { medici, nomeCompleto, type Medico } from '../../../lib/medici';

export function getStaticPaths() {
  return medici.filter((m) => (m as any).blog).map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Medico };
const tutti = [{ ...m.articolo, href: `/${m.slug}/articolo` }, ...((m as any).blog as any[]).map((b) => ({ ...b, href: `/${m.slug}/blog/${b.id}` }))];
const [primo, ...resto] = tutti;
---
<Base title={`Blog · ${nomeCompleto(m)}`} description={`Articoli di ${nomeCompleto(m)}, ${m.firma.toLowerCase()} a ${m.citta}.`} tema={m.tema}>
  <Header m={m} home={false} />
  <main>
    <section data-hero-section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 pb-10 pt-10 sm:px-8 sm:pt-14">
        <a href={`/${m.slug}`} class="inline-flex items-center gap-2 text-sm text-muted hover:text-brand"><Icona nome="freccia" class="h-4 w-4 rotate-180" /> Torna alla home</a>
        <h1 class="mt-8 font-head text-[2.4rem] font-semibold leading-tight sm:text-[3.2rem]">Il blog</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">Spiego in modo semplice i disturbi che vedo più spesso in studio, cosa fare e quando farsi visitare.</p>
      </div>
    </section>
    <section class="px-5 py-12 sm:px-8 sm:py-16">
      <div class="mx-auto max-w-6xl">
        <a href={primo.href} class="group grid items-center gap-8 md:grid-cols-2" data-reveal>
          <img src={primo.img} alt="" width="1500" height="843" class="aspect-[16/10] w-full rounded-md object-cover" />
          <span class="block">
            <span class="text-xs font-semibold uppercase tracking-[0.14em] text-brand">{primo.categoria} · {primo.tempoLettura}</span>
            <span class="mt-3 block font-head text-[1.9rem] font-semibold leading-tight group-hover:text-brand">{primo.titolo}</span>
            <span class="mt-4 block text-muted">{primo.intro}</span>
            <span class="mt-5 inline-flex items-center gap-2 font-semibold text-brand">Legga l'articolo <Icona nome="freccia" class="h-4 w-4" /></span>
          </span>
        </a>
        <div class="mt-14 grid gap-8 border-t border-line pt-10 md:grid-cols-3" data-stagger>
          {resto.map((x) => (
            <a href={x.href} class="group block">
              <img src={x.img} alt="" width="1200" height="900" loading="lazy" class="aspect-[4/3] w-full rounded-md object-cover" />
              <span class="mt-4 block text-xs font-semibold uppercase tracking-[0.14em] text-brand">{x.categoria} · {x.tempoLettura}</span>
              <span class="mt-2 block font-head text-xl font-semibold leading-snug group-hover:text-brand">{x.titolo}</span>
              <span class="mt-2 block text-[15px] leading-relaxed text-muted">{x.intro}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
    <CtaFinale m={m} />
  </main>
  <Footer m={m} />
  <CtaMobile m={m} />
  <script>import '../../../scripts/motion.ts';</script>
</Base>

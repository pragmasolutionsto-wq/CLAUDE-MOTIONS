---
import ArticoloPagina from '../../components/ArticoloPagina.astro';
import { medici, type Medico } from '../../lib/medici';

export function getStaticPaths() {
  return medici.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Medico };
---
<ArticoloPagina m={m} a={m.articolo} />

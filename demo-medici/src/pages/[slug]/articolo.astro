---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Icona from '../../components/Icona.astro';
import CtaFinale from '../../components/CtaFinale.astro';
import CtaMobile from '../../components/CtaMobile.astro';
import Footer from '../../components/Footer.astro';
import { medici, nomeCompleto, type Medico } from '../../lib/medici';

export function getStaticPaths() {
  return medici.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Medico };
const a = m.articolo;
---
<Base title={`${a.titolo} · ${nomeCompleto(m)}`} description={a.intro} tema={m.tema}>
  <Header m={m} home={false} />
  <main>
    <section data-hero-section class="border-b border-line">
      <div class="mx-auto max-w-3xl px-5 pb-12 pt-10 sm:px-8 sm:pt-14">
        <a href={`/${m.slug}#articoli`} class="inline-flex items-center gap-2 text-sm text-muted hover:text-brand">
          <Icona nome="freccia" class="h-4 w-4 rotate-180" /> Torna alla home
        </a>
        <p class="label mt-10">{a.categoria} · {a.tempoLettura} di lettura</p>
        <h1 class="mt-4 text-[2.2rem] font-semibold leading-[1.1] sm:text-[3.1rem]">{a.titolo}</h1>
        <p class="mt-6 text-xl leading-relaxed text-ink/80">{a.intro}</p>
        <div class="mt-8 flex items-center gap-4 border-t border-line pt-6">
          <img src={m.foto.volto} alt={nomeCompleto(m)} width="56" height="56" class="h-14 w-14 rounded-full object-cover" />
          <span class="text-sm"><span class="block font-semibold">{nomeCompleto(m)}</span><span class="text-muted">{m.specialita}</span></span>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-4xl px-5 pt-10 sm:px-8">
      <div class="relative overflow-hidden rounded-2xl">
        <img src={a.img} alt="" width="1600" height="900" class="aspect-[16/9] w-full object-cover object-[50%_35%]" />
      </div>
    </div>

    <article class="prose-medico mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
      {a.sezioni.map((s) => (
        <section data-reveal>
          <h2>{s.titolo}</h2>
          {s.paragrafi.map((p) => <p>{p}</p>)}
          {s.elenco && <ul>{s.elenco.map((li) => <li>{li}</li>)}</ul>}
          {s.chiusura && <p>{s.chiusura}</p>}
        </section>
      ))}
      <aside class="mt-12 rounded-md bg-surface p-6 text-sm leading-relaxed text-muted" data-reveal>{a.nota}</aside>
    </article>


    <CtaFinale m={m} />
  </main>
  <Footer m={m} />
  <CtaMobile m={m} />
  <script>import '../../scripts/motion.ts';</script>
</Base>

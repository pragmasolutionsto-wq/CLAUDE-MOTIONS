        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="font-head text-[2.5rem] font-extrabold leading-tight tracking-[-0.03em] text-deep sm:text-[3.2rem]" data-sale>Dal mio blog</h2>

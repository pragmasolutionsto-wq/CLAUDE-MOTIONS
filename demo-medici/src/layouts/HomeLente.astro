---
// Layout "lente" (prima demo: Dott. Daniele Agosta, dermatologo e venereologo, Alba e Torino). La pelle vista al dermatoscopio:
// lente con reticolo millimetrato come motivo (ritratto scontornato dentro la lente, che ruota allo scroll), Bricolage Grotesque +
// Public Sans, verde acqua della sua divisa #1A7A7C + corallo #E8664A per i segnali, angoli morbidi (20-28px) e pulsanti a pillola.
// Interattivi utili: prenotazione per prestazione con prezzo, studio e canale giusto (MioDottore ad Alba, telefono altrove, mail) e
// «messaggio discreto» per la venereologia; listino per area con «Prenoti»; ABCDE dei nei nella lente (lettera × rassicurante/da far
// vedere, righello in mm); venereologia su fondo scuro con prenotazione discreta; recensioni vere filtrabili per tema con «Mostra altre».
import Base from './Base.astro';
import Icona from '../components/Icona.astro';
import PrenotaCalendario from '../components/PrenotaCalendario.astro';
import Footer from '../components/Footer.astro';
import CtaMobile from '../components/CtaMobile.astro';
import { telHref, mapsHref, emailRichieste, type Medico } from '../lib/medici';

interface Props { m: Medico }
const { m } = Astro.props;
const x = m as any;
const foto = x.foto;
const servizi = x.servizi as any[];
const aree = x.areePrezzi as any[];
const sedi = x.sediDati as any[];
const mail = emailRichieste(m);
const rec = x.recensioniSito as any[];
const temi = x.temi as any[];
const blog = [{ ...m.articolo, href: `/${m.slug}/articolo` }, ...(x.blog as any[]).map((b) => ({ ...b, href: `/${m.slug}/blog/${b.id}` }))];
const ig = m.instagram;
const testo0 = `Buongiorno Dottore, vorrei prenotare ${servizi[0].frase} presso ${sedi[0].frase}.`;

// --- nei per l'ABCDE (lente 400×400, 1 mm = 20 px)
const MM = 20, CX = 200, CY = 186;
const liscio = (pts: number[][]) => {
  const n = pts.length; let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n], p1 = pts[i], p2 = pts[(i + 1) % n], p3 = pts[(i + 2) % n];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6], c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return d + ' Z';
};
const punti = (r: (t: number) => number, n = 48, cx = CX, cy = CY) => Array.from({ length: n }, (_, i) => { const t = (i / n) * Math.PI * 2; return [cx + r(t) * Math.cos(t), cy + r(t) * Math.sin(t)]; });
const spezzato = (pts: number[][]) => 'M' + pts.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' L') + ' Z';
const tondo = (r0: number) => liscio(punti((t) => r0 * (1 + 0.035 * Math.sin(3 * t) + 0.02 * Math.cos(5 * t))));
const asim = liscio(punti((t) => 46 * (1 + 0.3 * Math.cos(t) + 0.12 * Math.sin(2 * t + 1) + 0.05 * Math.sin(5 * t))));
const caso = (i: number) => { const v = Math.sin(i * 12.9898) * 43758.5453; return v - Math.floor(v); };
const frast = spezzato(Array.from({ length: 46 }, (_, i) => { const t = (i / 46) * Math.PI * 2; const r = 50 * (1 + 0.1 * Math.sin(2 * t + 0.7) + 0.05 * Math.cos(5 * t)) * (0.9 + 0.2 * caso(i + 3)); return [CX + r * Math.cos(t), CY + r * Math.sin(t)]; }));
const largo = liscio(punti((t) => 70 * (1 + 0.06 * Math.sin(3 * t + 0.5) + 0.04 * Math.cos(4 * t))));
const evolve = liscio(punti((t) => 58 * (1 + 0.16 * Math.cos(t - 0.6) + 0.08 * Math.sin(3 * t) + 0.04 * Math.cos(7 * t))));
const MARRONE = '#7A4A2F';
const nei: Record<string, any> = {
  'A-ok': { d: tondo(46), assi: true }, 'A-ko': { d: asim, assi: true },
  'B-ok': { d: tondo(48) }, 'B-ko': { d: frast, sfuma: true },
  'C-ok': { d: tondo(48) }, 'C-ko': { d: tondo(50), macchie: true },
  'D-ok': { d: tondo(28), righello: true }, 'D-ko': { d: largo, righello: true },
  'E-ok': { d: tondo(46), prima: tondo(46) }, 'E-ko': { d: evolve, prima: tondo(40), scuro: true }
};
const tacche = Array.from({ length: 72 }, (_, i) => i);
const anello = (cx: number, r: number, lungo: number, corto: number, verso: number) => tacche.map((i) => { const a = (i / 72) * Math.PI * 2; const l = i % 6 === 0 ? lungo : corto; return { x1: cx + r * Math.cos(a), y1: cx + r * Math.sin(a), x2: cx + (r + verso * l) * Math.cos(a), y2: cx + (r + verso * l) * Math.sin(a), w: i % 6 === 0 }; });
const tHero = anello(260, 250, 20, 9, -1), tNeo = anello(200, 192, 14, 6, 1), tVen = anello(200, 180, 14, 6, -1);
---
<Base title={m.meta.title} description={m.meta.description} tema={m.tema}>
  <header class="sticky z-40 border-b border-line bg-white/90 backdrop-blur" style="top: var(--banner-h)">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-8">
      <a href={`/${m.slug}`} class="flex min-w-0 items-center gap-3 leading-tight">
        <span class="lente-mini relative grid h-10 w-10 shrink-0 place-items-center rounded-full border-[2.5px] border-brand" aria-hidden="true"><span class="h-2.5 w-2.5 rounded-full bg-brand2"></span></span>
        <span class="min-w-0"><span class="block whitespace-nowrap font-head text-[17px] font-bold tracking-[-0.01em] text-deep sm:text-[19px]">Dott. Daniele Agosta</span><span class="block text-[12px] font-medium text-brand">Dermatologo e venereologo</span></span>
      </a>
      <nav class="hidden items-center gap-6 text-[14.5px] font-medium text-ink/70 xl:flex" aria-label="Sezioni">
        <a href="#aree" class="hover:text-brand">Prezzi</a><a href="#nei" class="hover:text-brand">Nei</a><a href="#venereologia" class="hover:text-brand">Venereologia</a><a href="#recensioni" class="hover:text-brand">Recensioni</a><a href="#chi-sono" class="hover:text-brand">Chi sono</a><a href="#sedi" class="hover:text-brand">Dove ricevo</a>
      </nav>
      <a href="#prenota-box" class="btn !min-h-[42px] shrink-0 !rounded-full bg-brand !px-5 text-sm text-white hover:bg-deep"><Icona nome="calendario" class="h-4 w-4" /> Prenoti</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden" data-hero>
      <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-16 pt-8 sm:px-8 lg:grid-cols-12 lg:items-center lg:pb-24 lg:pt-14">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-2 rounded-full bg-surface px-3.5 py-1.5 text-[13px] font-semibold text-brand" data-entra><span class="h-2 w-2 rounded-full bg-brand2"></span>{x.hero.eyebrow}</p>
          <h1 class="mt-5 font-head text-[3rem] font-extrabold leading-[0.98] tracking-[-0.035em] text-deep sm:text-[5.2rem]" data-titolo-hero>{x.hero.titolo}</h1>
          <p class="mt-6 max-w-xl text-[18px] leading-relaxed text-ink/80" data-entra>{x.hero.testo}</p>

          <!-- PRENOTAZIONE -->
          <div id="prenota-box" class="mt-9 rounded-[28px] bg-white p-5 shadow-[0_24px_70px_rgb(12_42_45/.13)] ring-1 ring-line sm:p-7" data-prenota-box data-mail={mail} data-oggetto={m.prenota.oggettoMail} data-mio={x.mioDottore}
            data-servizi={JSON.stringify(servizi.map((s) => ({ id: s.id, frase: s.frase, prezzo: s.prezzo, discreto: s.discreto })))} data-sedi={JSON.stringify(sedi.map((s) => ({ id: s.id, frase: s.frase, telefono: s.telefono, online: s.online, nome: s.nome })))} data-entra>
            <div class="grid gap-5 sm:grid-cols-[1fr_auto] sm:items-end">
              <label class="block"><span class="text-[12.5px] font-bold uppercase tracking-[0.14em] text-muted">Cosa vuole prenotare</span>
                <select class="campo mt-2 !rounded-2xl" data-servizio>{aree.map((a) => <optgroup label={a.nome}>{servizi.filter((s) => s.area === a.id).map((s) => <option value={s.id}>{s.nome}</option>)}</optgroup>)}</select></label>
              <p class="flex items-baseline gap-2 sm:block sm:text-right"><span class="text-[12.5px] font-bold uppercase tracking-[0.14em] text-muted sm:block">Prezzo</span><span class="font-head text-[2rem] font-extrabold leading-none text-deep sm:mt-2 sm:block" data-prezzo aria-live="polite">{servizi[0].prezzo}</span></p>
            </div>
            <p class="mt-5 text-[12.5px] font-bold uppercase tracking-[0.14em] text-muted" id="sede-label">Dove</p>
            <div class="mt-2 grid grid-cols-3 gap-1.5 rounded-full bg-surface p-1.5" role="group" aria-labelledby="sede-label">
              {sedi.map((s, i) => <button type="button" class="sede-pill rounded-full px-2 py-2.5 text-center text-[13.5px] font-semibold leading-tight sm:text-[14.5px]" data-sede={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.citta === 'Alba' && s.id === 'sanpaolo' ? 'San Paolo' : s.citta}<span class="block text-[11.5px] font-medium opacity-70">{s.breve}</span></button>)}
            </div>
            <label class="discreto mt-4 flex cursor-pointer items-start gap-3 rounded-2xl bg-surface px-4 py-3" hidden data-discreto-box>
              <input type="checkbox" class="mt-1 h-4 w-4 accent-[var(--c-brand)]" data-discreto />
              <span class="text-[14px] leading-snug"><span class="font-semibold text-deep">Messaggio discreto</span><span class="block text-muted">Nel messaggio non scrivo il motivo: ne parliamo di persona.</span></span>
            </label>
            <div class="mt-5 rounded-2xl border border-dashed border-brand/40 px-4 py-3">
              <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-brand">Il Suo messaggio</p>
              <p class="mt-1 text-[15.5px] leading-snug text-deep" data-anteprima aria-live="polite">{testo0}</p>
            </div>
            <div class="mt-4 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
              <a href={x.mioDottore} target="_blank" rel="noopener" class="btn !rounded-full bg-brand text-white hover:bg-deep" data-mio-link><Icona nome="calendario" /> Prenoti online su MioDottore</a>
              <a href={telHref(sedi[0].telefono)} class="btn !rounded-full border border-line bg-white text-deep hover:border-deep" data-tel-link><Icona nome="tel" /> <span data-tel-testo>{sedi[0].telefono}</span></a>
              <a href={`mailto:${mail}?subject=${encodeURIComponent(m.prenota.oggettoMail)}&body=${encodeURIComponent(testo0)}`} class="btn !rounded-full text-brand hover:bg-surface" data-mail-link><Icona nome="mail" /> Richiesta via mail</a>
            </div>
            <p class="mt-3 text-[13px] text-muted" data-canale-nota aria-live="polite">Ad Alba, in piazza Ferrero, vede subito gli orari liberi su MioDottore.</p>
          </div>
        </div>

        <div class="relative lg:col-span-5">
          <div class="lente relative mx-auto aspect-square w-full max-w-[520px]" data-lente-hero>
            <svg viewBox="0 0 520 520" class="absolute inset-0 h-full w-full" aria-hidden="true">
              <circle cx="260" cy="260" r="236" fill="var(--c-surface)" />
              <g class="reticolo" data-reticolo style="transform-origin: 260px 260px">
                <circle cx="260" cy="260" r="250" fill="none" stroke="var(--c-brand)" stroke-width="3" />
                {tHero.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--c-brand)" stroke-width={t.w ? 2.5 : 1.4} />)}
              </g>
            </svg>
            <div class="absolute inset-[9%] overflow-hidden rounded-full" data-foto-hero>
              <img src={foto.ritratto} alt={foto.ritrattoAlt} width="898" height="906" fetchpriority="high" class="absolute bottom-0 left-1/2 w-[96%] max-w-none -translate-x-1/2" data-foto-img />
            </div>
            <div class="absolute -bottom-2 left-0 rounded-[20px] bg-white px-4 py-3 shadow-[0_18px_40px_rgb(12_42_45/.14)] ring-1 ring-line sm:left-[-4%]" data-badge>
              <p class="font-head text-[1.9rem] font-extrabold leading-none text-deep"><span data-conta={x.recensioniMioDottore}>{x.recensioniMioDottore}</span></p>
              <p class="mt-1 text-[12.5px] font-medium text-muted">recensioni su MioDottore</p>
            </div>
            <div class="absolute right-0 top-[6%] rounded-full bg-deep px-4 py-2 text-[13px] font-semibold text-white shadow-lg" data-badge>Prezzi chiari, prima della visita</div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRESTAZIONI E PREZZI -->
    <section id="aree" class="bg-surface px-4 py-16 sm:px-8 sm:py-24" data-prezzi>
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7"><p class="text-[13px] font-bold uppercase tracking-[0.16em] text-brand2">Prestazioni e prezzi</p><h2 class="mt-2 font-head text-[2.5rem] font-extrabold leading-[1.02] tracking-[-0.03em] text-deep sm:text-[3.6rem]" data-sale>Sa quanto spende prima di entrare.</h2></div>
          <p class="text-[17px] leading-relaxed text-ink/80 lg:col-span-5">I prezzi sono quelli che indico sul mio sito e su MioDottore. Per i piccoli interventi il preventivo si fa in visita, perché dipende dalla lesione.</p>
        </div>
        <div class="-mx-4 mt-10 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:px-0" role="tablist" aria-label="Aree">
          {aree.map((a, i) => <button type="button" role="tab" id={`tab-${a.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="listino" tabindex={i === 0 ? 0 : -1} class="area-tab shrink-0 rounded-full border border-line px-4 py-2.5 text-[14.5px] font-semibold" data-area={a.id}>{a.nome} <span class="ml-1 text-[12px] opacity-60">{servizi.filter((s) => s.area === a.id).length}</span></button>)}
        </div>
        <div id="listino" role="tabpanel" class="mt-6 grid gap-3 md:grid-cols-2" data-listino aria-live="polite">
          {servizi.map((s) => (
            <article class="voce flex items-center gap-4 rounded-[22px] bg-white px-5 py-4 ring-1 ring-line" data-voce={s.id} data-area-voce={s.area} hidden={s.area !== aree[0].id}>
              <div class="min-w-0 flex-1"><h3 class="font-head text-[1.15rem] font-bold leading-snug text-deep">{s.nome}</h3><p class="mt-0.5 text-[14px] leading-snug text-muted">{s.nota}</p></div>
              <p class="shrink-0 text-right font-head text-[1.25rem] font-extrabold text-deep">{s.prezzo}</p>
              <button type="button" class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-surface text-brand hover:bg-brand hover:text-white" data-prenota-servizio={s.id} aria-label={`Prenoti: ${s.nome}`}><Icona nome="freccia" class="h-4 w-4" /></button>
            </article>
          ))}
        </div>
        <div class="mt-14">
          <p class="text-[13px] font-bold uppercase tracking-[0.16em] text-muted">Le patologie che curo più spesso</p>
          <ul class="mt-4 flex flex-wrap gap-2" data-stagger>{(x.patologie as string[]).map((p) => <li class="rounded-full bg-white px-3.5 py-1.5 text-[14px] text-ink/85 ring-1 ring-line">{p}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- ABCDE -->
    <section id="nei" class="px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12 lg:items-center" data-abcde data-voci={JSON.stringify(x.abcde)}>
        <div class="lg:col-span-6">
          <p class="text-[13px] font-bold uppercase tracking-[0.16em] text-brand2">Controllo dei nei</p>
          <h2 class="mt-2 font-head text-[2.5rem] font-extrabold leading-[1.02] tracking-[-0.03em] text-deep sm:text-[3.6rem]" data-sale>L'ABCDE, sotto la lente.</h2>
          <p class="mt-4 max-w-xl text-[17px] leading-relaxed text-ink/80">Cinque segnali che aiutano a notare un neo da far vedere. Scelga una lettera e confronti un neo di solito rassicurante con uno da controllare.</p>
          <div class="mt-8 flex gap-2" role="group" aria-label="Lettere">
            {(x.abcde as any[]).map((l, i) => <button type="button" class="lettera grid h-14 w-14 place-items-center rounded-2xl border border-line font-head text-[1.6rem] font-extrabold sm:h-16 sm:w-16" data-lettera={l.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={l.nome}>{l.id}</button>)}
          </div>
          <h3 class="mt-7 font-head text-[1.7rem] font-extrabold text-deep" data-lettera-nome>{x.abcde[0].nome}</h3>
          <div class="mt-4 inline-grid grid-cols-2 gap-1 rounded-full bg-surface p-1" role="group" aria-label="Confronto">
            <button type="button" class="stato-btn rounded-full px-4 py-2 text-[14px] font-semibold" data-stato="ok" aria-pressed="true">Di solito rassicurante</button>
            <button type="button" class="stato-btn rounded-full px-4 py-2 text-[14px] font-semibold" data-stato="ko" aria-pressed="false">Da far vedere</button>
          </div>
          <p class="mt-4 font-semibold text-brand" data-stato-testo aria-live="polite">{x.abcde[0].ok}</p>
          <p class="mt-2 max-w-xl text-[16px] leading-relaxed text-ink/80" data-lettera-testo>{x.abcde[0].testo}</p>
          <p class="mt-6 max-w-xl rounded-2xl bg-surface px-4 py-3 text-[14px] leading-relaxed text-muted">L'ABCDE aiuta a notare i cambiamenti, ma non sostituisce la visita. In studio osservo i nei con il dermatoscopio, in epiluminescenza. Attenzione anche al «brutto anatroccolo»: un neo diverso da tutti gli altri.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <button type="button" class="btn !rounded-full bg-deep text-white hover:bg-brand" data-prenota-servizio="nei"><Icona nome="lente" /> Prenoti un controllo dei nei</button>
            <a href={`/${m.slug}/blog/controllo-nei`} class="btn !rounded-full text-brand hover:bg-surface">Ogni quanto controllarli <Icona nome="freccia" class="h-4 w-4" /></a>
          </div>
        </div>
        <figure class="lg:col-span-6">
          <div class="mx-auto max-w-[460px]">
            <svg viewBox="0 0 400 400" class="w-full" role="img" aria-labelledby="neo-desc">
              <desc id="neo-desc" data-neo-desc>Un neo visto al dermatoscopio</desc>
              <defs>
                <clipPath id="ag-lente"><circle cx="200" cy="200" r="176" /></clipPath>
                <pattern id="ag-pelle" width="26" height="26" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><path d="M0 13h26M13 0v26" stroke="#D9B5A6" stroke-opacity=".45" stroke-width=".8" /></pattern>
                <clipPath id="ag-neo-c"><path d={nei['C-ko'].d} /></clipPath>
              </defs>
              <circle cx="200" cy="200" r="176" fill="var(--c-pelle)" />
              <circle cx="200" cy="200" r="176" fill="url(#ag-pelle)" />
              <g clip-path="url(#ag-lente)">
                {Object.entries(nei).map(([k, n]) => (
                  <g data-neo={k} style={k === 'A-ok' ? '' : 'opacity:0;visibility:hidden'}>
                    {n.prima && <path d={n.prima} fill="none" stroke="var(--c-deep)" stroke-width="1.6" stroke-dasharray="5 5" />}
                    {n.sfuma && <path d={n.d} fill={MARRONE} opacity=".35" transform={`translate(${CX} ${CY}) scale(1.12) translate(${-CX} ${-CY})`} />}
                    <path d={n.d} fill={n.scuro ? '#4A2A1A' : MARRONE} />
                    {n.macchie && <g clip-path="url(#ag-neo-c)"><ellipse cx="182" cy="172" rx="26" ry="20" fill="#2A1810" /><ellipse cx="226" cy="200" rx="22" ry="26" fill="#A6483A" /><ellipse cx="196" cy="222" rx="24" ry="14" fill="#6E7F93" /><ellipse cx="214" cy="160" rx="14" ry="10" fill="#C08A62" /></g>}
                    {n.scuro && <ellipse cx="214" cy="176" rx="20" ry="16" fill="#1E120C" />}
                    {n.assi && <g stroke="var(--c-deep)" stroke-width="1.4" stroke-dasharray="4 4" fill="none"><line x1="200" y1="110" x2="200" y2="262" /><line x1="120" y1="186" x2="280" y2="186" /></g>}
                  </g>
                ))}
                <g data-righello-mm>
                  <line x1="110" y1="318" x2="290" y2="318" stroke="var(--c-deep)" stroke-width="1.6" />
                  {Array.from({ length: 10 }, (_, i) => <line x1={110 + i * MM} y1="318" x2={110 + i * MM} y2={i % 5 === 0 ? 304 : 310} stroke="var(--c-deep)" stroke-width="1.4" />)}
                  <line x1={110 + 6 * MM} y1="296" x2={110 + 6 * MM} y2="326" stroke="var(--c-brand2)" stroke-width="2.6" data-sei-mm />
                  <text x="110" y="340" font-size="12" fill="var(--c-deep)">0</text><text x={110 + 6 * MM} y="342" font-size="12" font-weight="700" fill="var(--c-brand2)" text-anchor="middle">6 mm</text><text x="290" y="340" font-size="12" fill="var(--c-deep)" text-anchor="end">9</text>
                </g>
              </g>
              <circle cx="200" cy="200" r="180" fill="none" stroke="var(--c-deep)" stroke-width="8" />
              <g data-reticolo-neo style="transform-origin: 200px 200px">{tNeo.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--c-brand)" stroke-width={t.w ? 2 : 1.2} />)}</g>
            </svg>
          </div>

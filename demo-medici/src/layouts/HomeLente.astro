  </main>

  <Footer m={m} />
  <CtaMobile m={m} />
  <script>
    import '../scripts/motion.ts';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';
    gsap.registerPlugin(ScrollTrigger);
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.toggle('senza-moto', ridotto);
    let lenis: Lenis | null = null;
    const vaiA = (sel: string) => { const el = document.querySelector<HTMLElement>(sel)!; const y = el.getBoundingClientRect().top + window.scrollY - 100; if (lenis) lenis.scrollTo(y); else window.scrollTo({ top: y, behavior: 'auto' }); };

    // --- Prenotazione ---
    const box = document.querySelector<HTMLElement>('[data-prenota-box]')!;
    const SV = JSON.parse(box.dataset.servizi!) as { id: string; frase: string; prezzo: string; discreto: boolean }[];
    const SE = JSON.parse(box.dataset.sedi!) as { id: string; frase: string; telefono: string; online: boolean; nome: string }[];
    const selS = box.querySelector<HTMLSelectElement>('[data-servizio]')!;
    const pill = [...box.querySelectorAll<HTMLButtonElement>('[data-sede]')];
    const disc = box.querySelector<HTMLInputElement>('[data-discreto]')!;
    const discBox = box.querySelector<HTMLElement>('[data-discreto-box]')!;
    let ultimo = selS.value;
    const aggiorna = () => {
      const s = SV.find((k) => k.id === selS.value)!;
      if (s.id !== ultimo) { disc.checked = s.discreto; ultimo = s.id; }
      discBox.hidden = !s.discreto; if (!s.discreto) disc.checked = false;
      const se = SE.find((k) => k.id === pill.find((b) => b.getAttribute('aria-pressed') === 'true')!.dataset.sede)!;
      const msg = disc.checked ? `Buongiorno Dottore, vorrei prenotare una visita specialistica presso ${se.frase}. Preferisco spiegare il motivo di persona.` : `Buongiorno Dottore, vorrei prenotare ${s.frase} presso ${se.frase}.`;
      const ogg = disc.checked ? 'Richiesta di visita' : box.dataset.oggetto!;
      box.querySelector('[data-anteprima]')!.textContent = msg;
      box.querySelector('[data-prezzo]')!.textContent = s.prezzo;
      box.querySelector<HTMLAnchorElement>('[data-mail-link]')!.href = `mailto:${box.dataset.mail}?subject=${encodeURIComponent(ogg)}&body=${encodeURIComponent(msg)}`;
      const tel = box.querySelector<HTMLAnchorElement>('[data-tel-link]')!; tel.href = `tel:${se.telefono.replace(/\D/g, '')}`; box.querySelector('[data-tel-testo]')!.textContent = se.telefono;
      box.querySelector<HTMLElement>('[data-mio-link]')!.hidden = !se.online;
      tel.classList.toggle('principale', !se.online);
      box.querySelector('[data-canale-nota]')!.textContent = se.online ? 'Ad Alba, in piazza Ferrero, vede subito gli orari liberi su MioDottore.' : `${se.nome}: si prenota al telefono. Può anche inviare la richiesta via mail.`;
      box.dataset.stato = `${s.id}|${se.id}|${disc.checked ? 'discreto' : 'aperto'}`;
      if (!ridotto) gsap.fromTo('[data-anteprima]', { opacity: 0.35 }, { opacity: 1, duration: 0.3 });
    };
    selS.addEventListener('change', aggiorna); disc.addEventListener('change', aggiorna);
    pill.forEach((b) => b.addEventListener('click', () => { pill.forEach((k) => k.setAttribute('aria-pressed', String(k === b))); aggiorna(); }));
    const scegli = (id: string, discreto?: boolean) => { selS.value = id; aggiorna(); if (discreto !== undefined) { disc.checked = discreto; aggiorna(); } vaiA('#prenota-box'); selS.focus({ preventScroll: true }); };
    document.querySelectorAll<HTMLElement>('[data-prenota-servizio]').forEach((b) => b.addEventListener('click', () => scegli(b.dataset.prenotaServizio!)));
    document.querySelector('[data-prenota-discreto]')!.addEventListener('click', () => scegli('venereologica', true));
    aggiorna();

    // --- Listino per area ---
    const tabs = [...document.querySelectorAll<HTMLElement>('[data-area]')];
    const voci = [...document.querySelectorAll<HTMLElement>('[data-voce]')];
    const area = (t: HTMLElement) => {
      tabs.forEach((k) => { const on = k === t; k.setAttribute('aria-selected', String(on)); k.tabIndex = on ? 0 : -1; });
      document.getElementById('listino')!.setAttribute('aria-labelledby', t.id);
      const vis = voci.filter((v) => { const ok = v.dataset.areaVoce === t.dataset.area; v.hidden = !ok; return ok; });
      if (!ridotto) gsap.fromTo(vis, { y: 14, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.4, stagger: 0.04, ease: 'power2.out' });
      document.querySelector<HTMLElement>('[data-prezzi]')!.dataset.attiva = t.dataset.area;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => area(t));
      t.addEventListener('keydown', (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!d) return; e.preventDefault(); const n = tabs[(i + d + tabs.length) % tabs.length]; n.focus(); area(n); });
    });

    // --- ABCDE ---
    const ab = document.querySelector<HTMLElement>('[data-abcde]')!;
    const AB = JSON.parse(ab.dataset.voci!) as { id: string; nome: string; ok: string; ko: string; testo: string }[];
    const st = { l: 'A', s: 'ok' };
    const mostra = (anima = true) => {
      const v = AB.find((k) => k.id === st.l)!; const key = `${st.l}-${st.s}`;
      ab.querySelectorAll<SVGGElement>('[data-neo]').forEach((g) => { const on = g.dataset.neo === key; if (ridotto || !anima) gsap.set(g, { autoAlpha: on ? 1 : 0 }); else gsap.to(g, { autoAlpha: on ? 1 : 0, duration: 0.45, ease: 'power2.out', overwrite: true }); });
      ab.querySelectorAll('[data-lettera]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.lettera === st.l)));
      ab.querySelectorAll('[data-stato]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.stato === st.s)));
      ab.querySelector('[data-lettera-nome]')!.textContent = v.nome;
      ab.querySelector('[data-lettera-testo]')!.textContent = v.testo;
      const t = ab.querySelector<HTMLElement>('[data-stato-testo]')!; t.textContent = st.s === 'ok' ? v.ok : v.ko; t.classList.toggle('text-brand2', st.s === 'ko'); t.classList.toggle('text-brand', st.s === 'ok');
      ab.querySelector('[data-neo-desc]')!.textContent = `${v.nome}: ${st.s === 'ok' ? v.ok : v.ko}`;
      const r = ab.querySelector<SVGGElement>('[data-righello-mm]')!; if (ridotto || !anima) gsap.set(r, { autoAlpha: st.l === 'D' ? 1 : 0 }); else gsap.to(r, { autoAlpha: st.l === 'D' ? 1 : 0, duration: 0.4 });
      ab.dataset.mostra = key;
    };
    ab.querySelectorAll<HTMLElement>('[data-lettera]').forEach((b) => b.addEventListener('click', () => { st.l = b.dataset.lettera!; mostra(); }));
    ab.querySelectorAll<HTMLElement>('[data-stato]').forEach((b) => b.addEventListener('click', () => { st.s = b.dataset.stato!; mostra(); }));
    mostra(false);

    // --- Recensioni ---
    const rc = document.querySelector<HTMLElement>('[data-recensioni]')!;
    const tutte = [...rc.querySelectorAll<HTMLElement>('[data-rec]')];
    const PASSO = 9; let tema = '', quante = PASSO;
    const filtra = (anima = false) => {
      const ok = tutte.filter((r) => !tema || r.dataset.temi!.split(' ').includes(tema));
      tutte.forEach((r) => { r.hidden = true; });
      const vis = ok.slice(0, quante); vis.forEach((r) => { r.hidden = false; });
      rc.querySelector<HTMLElement>('[data-altre]')!.hidden = ok.length <= quante;
      rc.querySelector('[data-rec-conta]')!.textContent = `${vis.length} di ${ok.length}`;
      rc.dataset.tema = tema;
      if (anima && !ridotto) gsap.fromTo(vis.slice(anima === true ? 0 : 0), { y: 12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.35, stagger: 0.03 });
    };
    rc.querySelectorAll<HTMLElement>('[data-tema]').forEach((b) => b.addEventListener('click', () => { tema = b.dataset.tema!; quante = PASSO; rc.querySelectorAll('[data-tema]').forEach((k) => k.setAttribute('aria-pressed', String(k === b))); filtra(true); }));
    rc.querySelector('[data-altre]')!.addEventListener('click', () => { quante += PASSO; filtra(); });
    filtra();

    if (!ridotto) {
      lenis = new Lenis({ anchors: { offset: -100 }, lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis!.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
      const h = document.querySelector<HTMLElement>('[data-titolo-hero]')!;
      const parole = (h.textContent ?? '').trim().split(/\s+/);
      h.setAttribute('aria-label', parole.join(' '));
      h.innerHTML = parole.map((w, i) => `<span class="inline-block overflow-hidden pb-[0.1em] align-bottom" aria-hidden="true"><span class="inline-block ${i >= 3 ? 'text-brand' : ''}">${w}</span></span>`).join(' ');
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.from('[data-reticolo]', { rotate: -90, autoAlpha: 0, duration: 1.6, ease: 'power3.inOut' })
        .from('[data-foto-hero]', { clipPath: 'circle(0% at 50% 50%)', duration: 1.3, ease: 'power3.inOut' }, 0.2)
        .from('[data-foto-img]', { yPercent: 12, scale: 1.08, duration: 1.6 }, 0.3)
        .from(h.querySelectorAll(':scope > span > span'), { yPercent: 110, duration: 0.85, stagger: 0.06 }, 0.1)
        .from('[data-entra]', { y: 22, autoAlpha: 0, duration: 0.7, stagger: 0.1 }, 0.45)
        .from('[data-badge]', { y: 16, autoAlpha: 0, duration: 0.6, stagger: 0.12 }, 1.1);
      document.querySelectorAll<HTMLElement>('[data-conta]').forEach((el) => {
        const fine = Number(el.dataset.conta); const o = { v: 0 };
        gsap.to(o, { v: fine, duration: 1.6, delay: 1.1, ease: 'power2.out', onUpdate: () => { el.textContent = String(Math.round(o.v)); } });
      });
      gsap.to('[data-reticolo]', { rotate: 60, ease: 'none', scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } });
      gsap.to('[data-reticolo-neo]', { rotate: 90, ease: 'none', scrollTrigger: { trigger: '[data-abcde]', start: 'top bottom', end: 'bottom top', scrub: true } });
      gsap.utils.toArray<HTMLElement>('[data-sale]').forEach((el) => gsap.from(el, { y: 34, autoAlpha: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } }));
      gsap.from('.voce:not([hidden])', { y: 24, autoAlpha: 0, duration: 0.5, stagger: 0.05, scrollTrigger: { trigger: '[data-listino]', start: 'top 85%', once: true } });
      ScrollTrigger.create({ trigger: '[data-abcde]', start: 'top 60%', once: true, onEnter: () => { gsap.delayedCall(0.9, () => { if (st.l === 'A' && st.s === 'ok' && ab.dataset.toccato !== '1') { st.s = 'ko'; mostra(); } }); } });
      ab.addEventListener('click', () => { ab.dataset.toccato = '1'; }, true);
      gsap.fromTo('[data-ven-linea]', { scaleY: 0 }, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: '[data-ven-passi]', start: 'top 75%', end: 'bottom 60%', scrub: true } });
      gsap.from('[data-ven-passi] > li', { x: 24, autoAlpha: 0, duration: 0.7, stagger: 0.15, scrollTrigger: { trigger: '[data-ven-passi]', start: 'top 80%', once: true } });
      gsap.from('.rec:not([hidden])', { y: 30, autoAlpha: 0, duration: 0.6, stagger: 0.05, scrollTrigger: { trigger: '[data-muro]', start: 'top 85%', once: true } });
      gsap.fromTo('[data-storia-linea]', { scaleY: 0 }, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: '[data-storia]', start: 'top 75%', end: 'bottom 60%', scrub: true } });
      gsap.from('[data-sedi] > article', { y: 40, autoAlpha: 0, duration: 0.8, stagger: 0.12, scrollTrigger: { trigger: '[data-sedi]', start: 'top 85%', once: true } });
      gsap.from('[data-blog] > a', { y: 40, autoAlpha: 0, duration: 0.7, stagger: 0.1, scrollTrigger: { trigger: '[data-blog]', start: 'top 88%', once: true } });
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</Base>

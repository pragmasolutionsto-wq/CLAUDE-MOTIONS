---
// Template home v2 — conforme al METODO DEMO MEDICI (CLAUDE.md).
// Fondo bianco, foto vere del medico, suo logo e suoi colori, niente numerazioni/avatar/slogan/corsivi.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Icona from '../components/Icona.astro';
import CtaFinale from '../components/CtaFinale.astro';
import CtaMobile from '../components/CtaMobile.astro';
import Footer from '../components/Footer.astro';
import { nomeCompleto, telHref, mapsHref, type Medico } from '../lib/medici';

interface Props { m: Medico }
const { m } = Astro.props;
const ig = m.instagram;
---
<Base title={m.meta.title} description={m.meta.description} tema={m.tema}>
  <Header m={m} />

  <main>
    <!-- HERO: foto vera e grande, nome, specialità, una riga di fatti, due pulsanti -->
    <section data-hero-section class="border-b border-line">
      <div class="mx-auto grid max-w-7xl lg:grid-cols-12 lg:items-center lg:gap-12 lg:px-8 lg:py-16">
        <div class="lg:order-2 lg:col-span-7">
          <picture>
            <source media="(min-width: 1024px)" srcset={m.foto.hero} />
            <img src={m.foto.heroMobile} alt={m.foto.heroAlt} width="1020" height="1275" fetchpriority="high"
              class="h-[58svh] max-h-[560px] w-full object-cover object-[50%_25%] lg:aspect-[3/2] lg:h-auto lg:max-h-none lg:rounded-md" />
          </picture>
        </div>
        <div class="px-5 pb-12 pt-8 sm:px-8 lg:order-1 lg:col-span-5 lg:px-0 lg:py-0">
          <p class="label">{m.hero.eyebrow}</p>
          <h1 class="mt-4 text-[2.6rem] font-semibold leading-[1.02] sm:text-6xl">{nomeCompleto(m)}</h1>
          <p class="mt-3 text-xl text-muted sm:text-2xl">{m.specialita}</p>
          <ul class="mt-7 space-y-2 border-l-2 border-brand2 pl-4 text-[15px] leading-snug text-ink/85">
            {m.hero.fatti.map((f) => <li>{f}</li>)}
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={telHref(m.prenota.telefono)} class="btn btn-primary"><Icona nome="tel" /> {m.hero.ctaPrenota}</a>
            <a href="#contatti" class="btn btn-ghost">{m.hero.ctaContatta}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CHI È: foto a sinistra, testo a destra -->
    <section id="chi-e">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="lg:col-span-5" data-reveal>
          <img src={m.foto.dettaglio} alt={m.foto.dettaglioAlt} width="940" height="530" loading="lazy" class="w-full rounded-md object-cover lg:sticky lg:top-12" />
        </div>
        <div class="lg:col-span-7">
          <p class="label" data-reveal>{m.bio.titolo}</p>
          <div class="mt-5 space-y-4 text-lg leading-relaxed text-ink/85" data-reveal>
            {m.bio.paragrafi.map((p, i) => <p class={i === 0 ? 'text-xl leading-relaxed text-ink sm:text-[1.4rem]' : ''}>{p}</p>)}
          </div>
          <dl class="mt-10 border-t border-line" data-stagger>
            {m.bio.tappe.map((t) => (
              <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-[140px_1fr] sm:gap-6">
                <dt class="font-head text-[15px] font-semibold text-brand">{t.periodo}</dt>
                <dd class="leading-relaxed">{t.testo}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-sm leading-relaxed text-muted" data-reveal>Membro di: {m.bio.societa.join(' · ')}</p>
        </div>
      </div>
    </section>

    <!-- DI COSA SI OCCUPA: elenco pulito a due/tre colonne -->
    <section id="aree" class="border-t border-line">
      <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-12">
          <h2 class="text-4xl font-semibold leading-tight sm:text-5xl lg:col-span-5" data-reveal>{m.aree.titolo}</h2>
          <p class="text-lg leading-relaxed text-muted lg:col-span-6 lg:col-start-7 lg:pt-2" data-reveal>{m.aree.intro}</p>
        </div>
        <div class="mt-12 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {m.aree.voci.map((v) => (
            <div class="border-t border-line py-6">
              <h3 class="text-xl font-semibold leading-snug">{v.titolo}</h3>
              <p class="mt-2 leading-relaxed text-muted">{v.testo}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- COME LAVORA: l'unica sezione forte, colore scuro del brand -->
    <section class="bg-deep text-deep-ink">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:py-28">
        <div class="lg:col-span-4" data-reveal>
          <h2 class="text-4xl font-semibold leading-tight text-white sm:text-5xl">{m.metodo.titolo}</h2>
          <div class="mt-6 h-[3px] w-12 bg-brand2"></div>
        </div>
        <div class="grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:col-span-8" data-stagger>
          {m.metodo.punti.map((p) => (
            <div>
              <h3 class="text-lg font-semibold text-white">{p.titolo}</h3>
              <p class="mt-2 leading-relaxed text-deep-ink/75">{p.testo}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- RECENSIONI REALI dal suo sito, alla lettera -->
    {m.recensioni.voci.length > 0 && (
      <section class="border-b border-line">
        <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
          <h2 class="text-4xl font-semibold leading-tight sm:text-5xl" data-reveal>{m.recensioni.titolo}</h2>
          <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2" data-stagger>
            {m.recensioni.voci.map((r) => (
              <figure class="border-t border-line pt-6">
                <div class="flex gap-0.5 text-brand2" aria-label="5 stelle su 5">
                  {[0, 1, 2, 3, 4].map(() => <Icona nome="stella" class="h-4 w-4 fill-current" />)}
                </div>
                <blockquote class="mt-4 text-[17px] leading-relaxed text-ink/90">{r.testo}</blockquote>
                <figcaption class="mt-4 font-head text-[15px] font-semibold">{r.nome}</figcaption>
              </figure>
            ))}
          </div>
          <p class="mt-10 text-sm text-muted" data-reveal>{m.recensioni.nota}</p>
        </div>
      </section>
    )}

    <!-- ARTICOLI -->
    <section id="articoli">
      <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
        <h2 class="text-4xl font-semibold leading-tight sm:text-5xl" data-reveal>Articoli</h2>
        <div class="mt-12 grid gap-10 lg:grid-cols-12">
          <a href={`/${m.slug}/articolo`} class="group block rounded-md bg-surface p-7 sm:p-10 lg:col-span-7" data-reveal>
            <p class="label">{m.articolo.categoria} · {m.articolo.tempoLettura} di lettura</p>
            <h3 class="mt-4 text-3xl font-semibold leading-[1.15] group-hover:text-brand sm:text-[2.2rem]">{m.articolo.titolo}</h3>
            <p class="mt-5 leading-relaxed text-muted">{m.articolo.intro}</p>
            <span class="mt-8 inline-flex items-center gap-2 font-head font-semibold text-brand">
              Legga l'articolo <Icona nome="freccia" class="h-4 w-4" />
            </span>
          </a>
          <div class="lg:col-span-5" data-stagger>
            <p class="label !text-muted">In arrivo</p>
            {m.articoliInArrivo.map((a) => (
              <div class="mt-5 border-t border-line pt-5">
                <p class="text-sm text-muted">{a.categoria}</p>
                <h3 class="mt-1 text-xl font-semibold leading-snug">{a.titolo}</h3>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- INSTAGRAM: grafiche con suo logo, suoi colori, sua foto -->
    <section class="border-t border-line bg-surface">
      <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
        <div class="grid gap-6 lg:grid-cols-12">
          <h2 class="text-4xl font-semibold leading-tight sm:text-5xl lg:col-span-6" data-reveal>Dal profilo Instagram</h2>
          <p class="leading-relaxed text-muted lg:col-span-5 lg:col-start-8 lg:pt-3" data-reveal>{ig.nota}</p>
        </div>
        <div class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible" data-stagger>
          {ig.post.map((p) => (
            <article class="w-[84%] shrink-0 snap-center overflow-hidden rounded-md border border-line bg-bg sm:w-[60%] lg:w-auto">
              <header class="flex items-center gap-3 px-4 py-3">
                <img src={m.brand.marchio} alt="" width="32" height="32" class="h-8 w-8 rounded-full border border-line bg-white" />
                <span class="text-sm font-semibold">{ig.handle}</span>
                <Icona nome="puntini" class="ml-auto h-5 w-5 text-muted" />
              </header>

              {p.stile === 'foto' && (
                <div class="relative aspect-square overflow-hidden">
                  <img src={(m.foto as Record<string, string>)[p.immagine ?? 'postRitratto']} alt="" width="530" height="530" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top" />
                  <div class="absolute inset-x-0 bottom-0 bg-white px-5 py-4">
                    <p class="font-head text-2xl font-semibold leading-tight text-ink">{p.titolo}</p>
                    <p class="mt-1 text-sm text-brand">{p.sottotitolo}</p>
                  </div>
                </div>
              )}
              {p.stile === 'lista' && (
                <div class="flex aspect-square flex-col justify-between bg-white p-6">
                  <img src={m.brand.marchio} alt="" width="28" height="28" class="h-7 w-7" />
                  <div>
                    <p class="font-head text-[1.7rem] font-semibold leading-[1.1]">{p.titolo}</p>
                    <ul class="mt-4 space-y-2.5">
                      {p.punti?.map((x) => (
                        <li class="flex items-start gap-3 text-[15px] leading-snug"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand2"></span>{x}</li>
                      ))}
                    </ul>
                  </div>
                  <p class="text-xs text-muted">{nomeCompleto(m)} · Chirurgia della spalla</p>
                </div>
              )}
              {p.stile === 'domanda' && (
                <div class="flex aspect-square flex-col justify-between bg-brand p-6 text-white">
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/75">Domande frequenti</p>
                  <div>
                    <p class="font-head text-[1.9rem] font-semibold leading-[1.08]">{p.titolo}</p>
                    <p class="mt-4 text-lg text-white/90">{p.risposta}</p>
                  </div>
                  <p class="text-xs text-white/70">{nomeCompleto(m)} · Chirurgia della spalla</p>
                </div>
              )}

              <div class="flex items-center gap-4 px-4 pt-3 text-ink">
                <Icona nome="cuore" /><Icona nome="commento" /><Icona nome="invia" /><Icona nome="salva" class="ml-auto h-5 w-5" />
              </div>
              <div class="px-4 pb-5 pt-2">
                <p class="line-clamp-4 text-[13.5px] leading-relaxed">
                  <span class="font-semibold">{ig.handle}</span> {p.didascalia} <span class="text-brand">{p.hashtag}</span>
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- DOVE RICEVE: testo a sinistra, foto a destra -->
    <section id="sedi" class="border-t border-line">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="lg:col-span-7">
          <h2 class="text-4xl font-semibold leading-tight sm:text-5xl" data-reveal>{m.sedi.titolo}</h2>
          <div class="mt-10 grid gap-10 sm:grid-cols-2" data-stagger>
            {m.sedi.luoghi.map((l) => (
              <div>
                <p class="label">{l.tipo}</p>
                <p class="mt-3 text-lg leading-snug"><span class="font-semibold">{l.indirizzo}</span><br />{l.citta}</p>
                <ul class="mt-4 space-y-1.5">
                  {l.telefoni.map((t) => (
                    <li class="text-[15px]"><span class="text-muted">{t.label}: </span><a href={telHref(t.numero)} class="font-semibold text-ink hover:text-brand">{t.numero}</a></li>
                  ))}
                </ul>
                {l.mappa && (
                  <a href={mapsHref(l.indirizzo, l.citta)} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-[15px] font-semibold text-brand">
                    <Icona nome="pin" class="h-4 w-4" /> Apra in Google Maps
                  </a>
                )}
              </div>
            ))}
          </div>
          <div class="mt-12 border-t border-line pt-8" data-reveal>
            <p class="label !text-muted">Attività chirurgica</p>
            <ul class="mt-5 grid gap-6 sm:grid-cols-2">
              {m.sedi.strutture.map((s) => (
                <li class="flex items-center gap-4">
                  <span class="flex h-14 w-24 shrink-0 items-center justify-center"><img src={s.logo} alt={s.nome} width={s.logoW} height={s.logoH} loading="lazy" class="max-h-14 w-auto max-w-full object-contain" /></span>
                  <span><span class="block font-head text-lg font-semibold leading-tight">{s.nome}</span><span class="block text-sm leading-snug text-muted">{s.testo}</span></span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="lg:col-span-5" data-reveal>
          <img src={m.foto.diplomi} alt={m.foto.diplomiAlt} width="680" height="520" loading="lazy" class="w-full rounded-md object-cover" />
        </div>
      </div>
    </section>

    <CtaFinale m={m} />
  </main>

  <Footer m={m} />
  <CtaMobile m={m} />
  <script>import '../scripts/motion.ts';</script>
</Base>

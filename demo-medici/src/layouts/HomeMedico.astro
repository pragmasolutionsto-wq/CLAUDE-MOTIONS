---
// Template home v3 — METODO DEMO MEDICI + riferimento visivo AutoScout24 (card, chip, box prenotazione, caroselli)
// con i colori del medico. Il medico parla in prima persona, al paziente si dà del Lei.
// Foto di repertorio: nessuna didascalia sulle immagini, una sola nota nel footer.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Icona from '../components/Icona.astro';
import CtaFinale from '../components/CtaFinale.astro';
import CtaMobile from '../components/CtaMobile.astro';
import Footer from '../components/Footer.astro';
import PrenotaCalendario from '../components/PrenotaCalendario.astro';
import HeroBox from '../components/HeroBox.astro';
import { nomeCompleto, telHref, mapsHref, type Medico } from '../lib/medici';

interface Props { m: Medico }
const { m } = Astro.props;
const ig = m.instagram;
const luoghi = m.sedi.luoghi as Array<any>;
const principali = luoghi.some((l) => l.principale) ? luoghi.filter((l) => l.principale) : luoghi;
const altri = luoghi.some((l) => l.principale) ? luoghi.filter((l) => !l.principale) : [];
const foto = m.foto as Record<string, string | undefined>;
---
<Base title={m.meta.title} description={m.meta.description} tema={m.tema}>
  <Header m={m} />

  <main class="bg-surface">
    {m.foto.heroTipo === 'ritratto' ? (
      <!-- HERO (ritratto verticale): sfondo del colore della foto, ritratto a destra, box a sinistra -->
      <section data-hero-section class="relative overflow-hidden" style={`background:${m.foto.heroSfondo}`}>
        <div class="mx-auto grid max-w-7xl lg:grid-cols-12 lg:items-end lg:gap-8 lg:px-8">
          <div class="flex justify-center lg:order-2 lg:col-span-6 lg:justify-end">
            <img src={m.foto.hero} alt={m.foto.heroAlt} width="900" height="1100" fetchpriority="high"
              class="h-[340px] w-auto object-contain object-bottom sm:h-[440px] lg:h-[620px]" />
          </div>
          <div class="relative px-4 pb-8 sm:px-8 lg:order-1 lg:col-span-6 lg:self-center lg:px-0 lg:py-10">
            <HeroBox m={m} class="-mt-14 sm:-mt-20 lg:mt-0 lg:max-w-[500px]" />
          </div>
        </div>
      </section>
    ) : (
      <!-- HERO: foto vera a tutta larghezza + box prenotazione sovrapposto -->
      <section data-hero-section class="relative bg-white">
        <div class="relative h-[300px] overflow-hidden sm:h-[420px] lg:h-[600px]">
          <picture>
            <source media="(min-width: 1024px)" srcset={m.foto.hero} />
            <img src={m.foto.heroMobile} alt={m.foto.heroAlt} width="1020" height="1275" fetchpriority="high"
              class="h-full w-full object-cover object-[50%_28%] lg:object-[50%_30%]" />
          </picture>
        </div>
        <div class="relative mx-auto max-w-7xl px-4 sm:px-8 lg:absolute lg:inset-x-0 lg:top-1/2 lg:-translate-y-1/2">
          <HeroBox m={m} class="-mt-16 sm:-mt-24 lg:mt-0 lg:w-[480px]" />
        </div>
      </section>
    )}

    <!-- FIDUCIA: fatti veri con icone -->
    <section class="bg-white pb-10 pt-8 lg:pt-12">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-4 gap-y-6 px-4 sm:px-8 lg:grid-cols-4" data-stagger>
        {m.fiducia.map((f) => (
          <div class="flex items-start gap-3">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand/10 text-brand"><Icona nome={f.icona} class="h-6 w-6" /></span>
            <div><p class="font-head text-[17px] font-semibold leading-tight">{f.titolo}</p><p class="mt-0.5 text-[13px] leading-snug text-muted">{f.testo}</p></div>
          </div>
        ))}
      </div>
    </section>

    <!-- DI COSA MI OCCUPO: card con foto (repertorio) -->
    <section id="aree" class="py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="titolo-sez" data-reveal>{m.aree.titolo}</h2>
          <p class="max-w-md text-muted" data-reveal>{m.aree.intro}</p>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {m.aree.voci.map((v) => (
            <article class="card card-hover group flex flex-col overflow-hidden">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img src={v.img} alt="" width="1200" height="900" loading="lazy" class="h-full w-full object-cover transition-[scale] duration-500 group-hover:scale-[1.03]" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-xl font-semibold leading-snug">{v.titolo}</h3>
                <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{v.testo}</p>
                <a href="#prenota" class="mt-4 inline-flex items-center gap-2 text-[15px] font-semibold text-brand">Prenoti una visita <Icona nome="freccia" class="h-4 w-4" /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PRENOTAZIONE: calendario -->
    <PrenotaCalendario m={m} />

    <!-- CHI SONO: foto vera + testo in prima persona + percorso -->
    <section id="chi-sono" class="bg-white py-16 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-8 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5" data-reveal>
          {foto.dettaglio ? (
          <div class="relative">
            <img src={m.foto.dettaglio} alt={m.foto.dettaglioAlt} width="940" height="530" loading="lazy" class="w-full rounded-2xl object-cover shadow-lg" />
            <div class="card absolute -bottom-6 right-4 flex items-center gap-3 px-4 py-3 sm:right-6">
              <img src={m.foto.volto} alt="" width="48" height="48" class="h-12 w-12 rounded-full object-cover" />
              <div><p class="font-head font-semibold leading-tight">{nomeCompleto(m)}</p><p class="text-xs text-muted">{m.firma}</p></div>
            </div>
          </div>
          ) : (
            <div class="card overflow-hidden lg:sticky lg:top-28">
              <div class="flex items-center gap-4 bg-deep p-5 text-white">
                <img src={m.foto.volto} alt={nomeCompleto(m)} width="64" height="64" class="h-16 w-16 rounded-full object-cover ring-2 ring-white/30" />
                <div><p class="font-head text-xl font-semibold leading-tight">{nomeCompleto(m)}</p><p class="text-sm text-white/70">{m.firma}</p></div>
              </div>
              <dl class="grid grid-cols-2 gap-px bg-line">
                {(m.bio as any).numeri?.map((n: any) => (
                  <div class="bg-white p-5"><dt class="font-head text-3xl font-semibold text-brand">{n.valore}</dt><dd class="mt-1 text-[13px] leading-snug text-muted">{n.testo}</dd></div>
                ))}
              </dl>
            </div>
          )}
        </div>
        <div class="lg:col-span-7">
          <h2 class="titolo-sez" data-reveal>{m.bio.titolo}</h2>
          <div class="mt-5 space-y-4 text-[17px] leading-relaxed text-ink/85" data-reveal>
            {m.bio.paragrafi.map((p, i) => <p class={i === 0 ? 'text-xl text-ink' : ''}>{p}</p>)}
          </div>
          <ol class="relative mt-8 space-y-4 border-l-2 border-brand/20 pl-6" data-stagger>
            {m.bio.tappe.map((t) => (
              <li class="relative">
                <span class="absolute -left-[33px] top-1.5 h-4 w-4 rounded-full border-[3px] border-white bg-brand shadow"></span>
                <p class="font-head text-[15px] font-semibold text-brand">{t.periodo}</p>
                <p class="mt-0.5 leading-relaxed">{t.testo}</p>
              </li>
            ))}
          </ol>
          <div class="mt-8">
            <p class="text-[13px] font-semibold uppercase tracking-wide text-muted">{m.bio.societaLabel}</p>
            <div class="mt-2 flex flex-wrap gap-2">{m.bio.societa.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- COME LAVORO: griglia mista foto/icone -->
    <section id="come-lavoro" class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="titolo-sez" data-reveal>{m.metodo.titolo}</h2>
          <p class="max-w-md text-muted" data-reveal>{m.metodo.intro}</p>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-stagger>
          {m.metodo.punti.map((p, i) => p.img ? (
            <article class={`card flex flex-col overflow-hidden ${i === 0 ? 'lg:row-span-2' : ''}`}>
              <div class={`relative overflow-hidden ${i === 0 ? 'aspect-square lg:aspect-auto lg:flex-1' : 'aspect-[16/9]'}`}>
                <img src={p.img} alt={p.imgAlt ?? ''} width="800" height="600" loading="lazy" class="h-full w-full object-cover object-top" />
              </div>
              <div class="p-5">
                <h3 class="text-xl font-semibold">{p.titolo}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{p.testo}</p>
              </div>
            </article>
          ) : (
            <article class="card flex gap-4 p-5">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand2/15 text-brand"><Icona nome={p.icona} class="h-6 w-6" /></span>
              <div>
                <h3 class="text-xl font-semibold">{p.titolo}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{p.testo}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- BANDA: immagine larga (repertorio) con box -->
    <section class="mx-auto max-w-7xl px-4 sm:px-8">
      <div class="relative sm:overflow-hidden sm:rounded-2xl" data-reveal>
        <img src={m.banda.img} alt="" width="2000" height="857" loading="lazy" class="h-[220px] w-full rounded-2xl object-cover object-[60%_50%] sm:h-[400px]" />
        <div class="relative -mt-12 px-3 pb-1 sm:absolute sm:inset-x-auto sm:bottom-8 sm:left-8 sm:mt-0 sm:max-w-md sm:px-0 sm:pb-0">
          <div class="card p-5 sm:p-6">
            <h2 class="font-head text-2xl font-semibold leading-tight">{m.banda.titolo}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{m.banda.testo}</p>
            <a href="#prenota" class="btn btn-primary mt-4 w-full sm:w-auto"><Icona nome="calendario" /> {m.hero.ctaPrenota}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- RECENSIONI: carosello -->
    {m.recensioni.voci.length > 0 && (
      <section class="py-16 sm:py-24" data-carosello>
        <div class="mx-auto max-w-7xl px-4 sm:px-8">
          <div class="flex items-end justify-between gap-4">
            <div>
              <h2 class="titolo-sez" data-reveal>{m.recensioni.titolo}</h2>
              <p class="mt-2 flex items-center gap-2 text-muted"><span class="flex text-brand2">{[0,1,2,3,4].map(() => <Icona nome="stella" class="h-4 w-4 fill-current" />)}</span> 5 su 5 · {m.recensioni.voci.length} recensioni</p>
            </div>
            <div class="hidden gap-2 sm:flex">
              <button type="button" data-scorri="-1" class="grid h-11 w-11 place-items-center rounded-full border border-line bg-white hover:border-brand hover:text-brand" aria-label="Precedente"><Icona nome="sx" /></button>
              <button type="button" data-scorri="1" class="grid h-11 w-11 place-items-center rounded-full border border-line bg-white hover:border-brand hover:text-brand" aria-label="Successiva"><Icona nome="dx" /></button>
            </div>
          </div>
          <div data-traccia class="-mx-4 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0 [scrollbar-width:none]">
            {m.recensioni.voci.map((r) => (
              <figure class="card flex w-[85%] shrink-0 snap-start flex-col p-6 sm:w-[46%] lg:w-[31.5%]">
                <div class="flex gap-0.5 text-brand2" aria-label="5 stelle su 5">{[0,1,2,3,4].map(() => <Icona nome="stella" class="h-4 w-4 fill-current" />)}</div>
                <blockquote class="mt-4 flex-1 text-[16px] leading-relaxed text-ink/90">“{r.testo}”</blockquote>
                <figcaption class="mt-5 flex items-center gap-3 border-t border-line pt-4">
                  <span class="font-head font-semibold">{r.nome}</span>
                  <span class="ml-auto rounded-full bg-surface px-2.5 py-1 text-[11px] text-muted">Recensione dal sito</span>
                </figcaption>
              </figure>
            ))}
          </div>
          <p class="mt-4 text-sm text-muted">{m.recensioni.nota}</p>
        </div>
      </section>
    )}

    <!-- ARTICOLI: card con immagini -->
    <section id="articoli" class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-8">
        <h2 class="titolo-sez" data-reveal>Articoli</h2>
        <div class="mt-8" data-reveal>
          <a href={`/${m.slug}/articolo`} class="card card-hover group flex flex-col overflow-hidden lg:flex-row">
            <div class="relative aspect-[16/9] overflow-hidden lg:aspect-auto lg:w-1/2">
              <img src={m.articolo.img} alt="" width="1600" height="900" loading="lazy" class="h-full w-full object-cover object-[50%_35%]" />
              <span class="absolute left-3 top-3 rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white">Nuovo</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="label">{m.articolo.categoria} · {m.articolo.tempoLettura}</p>
              <h3 class="mt-2 text-2xl font-semibold leading-snug group-hover:text-brand">{m.articolo.titolo}</h3>
              <p class="mt-3 line-clamp-4 flex-1 text-[15px] leading-relaxed text-muted">{m.articolo.intro}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-brand">Legga l'articolo <Icona nome="freccia" class="h-4 w-4" /></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- INSTAGRAM -->
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="titolo-sez" data-reveal>Dal mio profilo Instagram</h2>
          <p class="inline-flex w-fit items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs text-muted shadow-sm"><img src="/pragma-logo-sm.png" alt="" width="14" height="14" class="h-3.5 w-3.5" /> Proposta Pragma: il profilo oggi non esiste</p>
        </div>
        <div class="-mx-4 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-3 lg:overflow-visible" data-stagger>
          {ig.post.map((p) => (
            <article class="card w-[84%] shrink-0 snap-center overflow-hidden sm:w-[60%] lg:w-auto">
              <header class="flex items-center gap-3 px-4 py-3">
                <img src={m.brand.marchio} alt="" width="32" height="32" class="h-8 w-8 rounded-full border border-line bg-white p-0.5" />
                <span class="text-sm font-semibold">{ig.handle}</span>
                <Icona nome="puntini" class="ml-auto h-5 w-5 text-muted" />
              </header>
              {p.stile === 'foto' && (
                <div class="relative aspect-square overflow-hidden">
                  <img src={foto[p.immagine ?? 'postRitratto']} alt="" width="530" height="530" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top" />
                  <div class="absolute inset-x-3 bottom-3 rounded-xl bg-white px-4 py-3 shadow">
                    <p class="font-head text-xl font-semibold leading-tight text-ink">{p.titolo}</p>
                    <p class="mt-0.5 text-sm text-brand">{p.sottotitolo}</p>
                  </div>
                </div>
              )}
              {p.stile === 'lista' && (
                <div class="flex aspect-square flex-col justify-between bg-white p-6">
                  <img src={m.brand.marchio} alt="" width="36" height="36" class="h-9 w-9" />
                  <div>
                    <p class="font-head text-[1.6rem] font-semibold leading-[1.1]">{p.titolo}</p>
                    <ul class="mt-4 space-y-2">
                      {p.punti?.map((x) => <li class="flex items-start gap-2.5 rounded-lg bg-surface px-3 py-2 text-[14px] leading-snug"><Icona nome="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand2" />{x}</li>)}
                    </ul>
                  </div>
                  <p class="text-xs text-muted">{nomeCompleto(m)} · {m.firma}</p>
                </div>
              )}
              {p.stile === 'domanda' && (
                <div class="relative flex aspect-square flex-col justify-between overflow-hidden bg-brand p-6 text-white">
                  <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full border-[18px] border-white/10"></div>
                  <span class="w-fit rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">Domande frequenti</span>
                  <div class="relative">
                    <p class="font-head text-[1.8rem] font-semibold leading-[1.08]">{p.titolo}</p>
                    <p class="mt-3 inline-block rounded-lg bg-white px-3 py-1.5 font-semibold text-brand">{p.risposta}</p>
                  </div>
                  <p class="text-xs text-white/70">{nomeCompleto(m)} · {m.firma}</p>
                </div>
              )}
              <div class="flex items-center gap-4 px-4 pt-3 text-ink">
                <Icona nome="cuore" /><Icona nome="commento" /><Icona nome="invia" /><Icona nome="salva" class="ml-auto h-5 w-5" />
              </div>
              <div class="px-4 pb-5 pt-2">
                <p class="line-clamp-3 text-[13.5px] leading-relaxed"><span class="font-semibold">{ig.handle}</span> {p.didascalia} <span class="text-brand">{p.hashtag}</span></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- DOVE RICEVO -->
    <section id="sedi" class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-8">
        <h2 class="titolo-sez" data-reveal>{m.sedi.titolo}</h2>
        <div class="mt-8 grid gap-5 lg:grid-cols-3" data-stagger>
          {principali.map((l) => (
            <div class="card flex flex-col p-6">
              <div class="flex items-center gap-3">
                <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand/10 text-brand"><Icona nome="pin" class="h-6 w-6" /></span>
                <div><p class="label">{l.tipo}</p><p class="font-head text-lg font-semibold leading-tight">{l.indirizzo}, {l.citta}</p></div>
              </div>
              <div class="mt-5 grid gap-2">
                {l.telefoni.map((t) => (
                  <a href={telHref(t.numero)} class="flex items-center justify-between rounded-xl bg-surface px-4 py-3 text-[15px] hover:bg-brand/10">
                    <span class="text-muted">{t.label}</span><span class="font-semibold">{t.numero}</span>
                  </a>
                ))}
              </div>
              {l.mappa && <a href={mapsHref(l.indirizzo, l.citta)} target="_blank" rel="noopener" class="btn btn-ghost mt-4 w-full !min-h-[46px] text-[15px]"><Icona nome="pin" class="h-4 w-4" /> Apra in Google Maps</a>}
            </div>
          ))}
          {foto.diplomi && (
            <div class="card relative overflow-hidden">
              <img src={foto.diplomi} alt={foto.diplomiAlt} width="680" height="520" loading="lazy" class="h-full min-h-[240px] w-full object-cover" />
            </div>
          )}
          {altri.length > 0 && (
            <div class="card p-6 lg:col-span-2">
              <p class="font-head text-xl font-semibold">{(m.sedi as any).altreLabel}</p>
              <ul class="mt-4 grid gap-x-8 gap-y-1 sm:grid-cols-2">
                {altri.map((l) => (
                  <li class="flex items-start justify-between gap-3 border-b border-line py-3">
                    <span><span class="block font-semibold leading-tight">{l.nome}</span><span class="text-sm text-muted">{l.indirizzo}, {l.citta}</span></span>
                    {l.telefoni[0] && <a href={telHref(l.telefoni[0].numero)} class="shrink-0 whitespace-nowrap rounded-full bg-surface px-3 py-1.5 text-sm font-semibold hover:bg-brand/10 hover:text-brand">{l.telefoni[0].numero}</a>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
        <p class="mt-10 text-[13px] font-semibold uppercase tracking-wide text-muted">{m.sedi.struttureLabel}</p>
        <div class={`mt-3 grid gap-4 sm:grid-cols-2 ${m.sedi.strutture.length === 3 ? 'lg:grid-cols-3' : ''}`} data-stagger>
          {m.sedi.strutture.map((s) => (
            <div class="card flex items-center gap-5 p-5">
              {s.logo
                ? <span class="flex h-14 w-28 shrink-0 items-center justify-center"><img src={s.logo} alt={s.nome} width={s.logoW} height={s.logoH} loading="lazy" class="max-h-14 w-auto max-w-full object-contain" /></span>
                : <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand/10 text-brand"><Icona nome="ospedale" class="h-6 w-6" /></span>}
              <span><span class="block font-head text-lg font-semibold leading-tight">{s.nome}</span><span class="block text-sm leading-snug text-muted">{s.testo}</span></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaFinale m={m} />
  </main>

  <Footer m={m} />
  <CtaMobile m={m} />
  <script>import '../scripts/motion.ts';</script>
</Base>

---
// Layout "radiografia" (prima demo: Dott. Pietro Pellegrino, ortopedia oncologica, CTO di Torino). Estetica da negativoscopio:
// sezioni scure, Archivo pesante, foto scontornata rivelata da una linea di scansione. Interattività: prenotazione con "Ho già esami";
// "Dove fa male?" (scheletro SVG con punti e schede, da tastiera); "Quando indagare un dolore osseo" (segnali da spuntare con esito);
// "Il percorso" a tappe; "Titanio o fibra di carbonio" (come appare la placca ai raggi X); formazione su pellicola da trascinare.
import Base from './Base.astro';
import Icona from '../components/Icona.astro';
import PrenotaCalendario from '../components/PrenotaCalendario.astro';
import Footer from '../components/Footer.astro';
import CtaMobile from '../components/CtaMobile.astro';
import { telHref, mapsHref, emailRichieste, type Medico } from '../lib/medici';

interface Props { m: Medico }
const { m } = Astro.props;
const x = m as any;
const foto = x.foto;
const box = x.hero.box;
const sede = (m.sedi.luoghi as any[])[0];
const mail = emailRichieste(m);
const ESAMI = ' Ho già degli esami (radiografia, TC o risonanza) da mostrarLe.';
const testo = (mo: string) => `Buongiorno Dottore, vorrei prenotare una visita per ${mo} presso ${sede.frase}.`;
const href0 = `mailto:${mail}?subject=${encodeURIComponent(m.prenota.oggettoMail)}&body=${encodeURIComponent(testo(box.motiviFrase[0]))}`;
const regioni = x.regioni as any[];
const blog = [{ ...m.articolo, href: `/${m.slug}/articolo` }, ...(x.blog as any[]).map((b) => ({ ...b, href: `/${m.slug}/blog/${b.id}` }))];
const ig = m.instagram;
// punti sullo scheletro (percentuali della figura)
const punti: Record<string, [number, number]> = { spalla: [30, 19], colonna: [50, 34], bacino: [50, 51], femore: [40, 57], ginocchio: [40, 76], diafisi: [60, 87], molli: [61, 64] };
const vert = Array.from({ length: 17 }, (_, i) => 66 + i * 8.6);
---
<Base title={m.meta.title} description={m.meta.description} tema={m.tema}>
  <header class="sticky z-40 border-b border-white/10 bg-deep/95 text-white backdrop-blur" style="top: var(--banner-h)">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-8">
      <a href={`/${m.slug}`} class="min-w-0 leading-none">
        <span class="block font-head text-[19px] font-extrabold tracking-tight sm:text-[23px]">Pietro Pellegrino</span>
        <span class="mt-1 block text-[11px] font-semibold uppercase tracking-[0.2em] text-brand2">Ortopedia oncologica</span>
      </a>
      <nav class="hidden items-center gap-6 text-[14px] font-medium text-white/70 xl:flex">
        <a href="#aree" class="hover:text-white">Dove fa male</a><a href="#segnali" class="hover:text-white">Quando indagare</a><a href="#percorso" class="hover:text-white">Il percorso</a><a href="#ricostruire" class="hover:text-white">Ricostruire</a><a href="#chi-sono" class="hover:text-white">Chi sono</a><a href="#articoli" class="hover:text-white">Blog</a><a href="#sedi" class="hover:text-white">Dove ricevo</a>
      </nav>
      <a href={telHref(m.prenota.telefono)} class="btn !min-h-[42px] shrink-0 !rounded-lg bg-brand !px-5 text-sm text-white hover:opacity-90"><Icona nome="tel" class="h-4 w-4" /> <span class="hidden sm:inline">{m.prenota.telefonoLabel}</span><span class="sm:hidden">Chiami</span></a>
    </div>
  </header>

  <main>
    <!-- HERO scura -->
    <section class="griglia-lastra relative overflow-hidden bg-deep text-white" data-hero>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-4 pb-16 pt-10 sm:px-8 lg:grid-cols-12 lg:items-end lg:pb-20 lg:pt-16">
        <div class="lg:col-span-7 lg:pb-10">
          <p class="font-mono text-[12px] uppercase tracking-[0.24em] text-brand2" data-entra>{x.hero.eyebrow}</p>
          <h1 class="mt-5 font-head text-[3rem] font-extrabold leading-[0.95] tracking-[-0.03em] sm:text-[5.4rem]" data-titolo-hero>{x.hero.titolo}</h1>
          <p class="mt-6 max-w-xl text-[18px] leading-relaxed text-deep-ink" data-entra>{x.hero.testo}</p>
          <ul class="mt-7 flex flex-wrap gap-2" data-entra>
            {['Tumori ossei benigni e maligni', 'Sarcomi dei tessuti molli', 'Metastasi ossee', 'Protesi su misura'].map((t) => <li class="rounded-md border border-white/20 px-3 py-1.5 text-[13.5px] font-semibold text-white/90">{t}</li>)}
          </ul>
        </div>
        <div class="relative order-first lg:order-none lg:col-span-5">
          <div class="relative mx-auto max-w-[420px] overflow-hidden rounded-[2.5rem] bg-brand" data-lastra>
            <span class="absolute inset-0 opacity-40 griglia-fine" aria-hidden="true"></span>
            <img src={foto.ritratto} alt={foto.ritrattoAlt} width="477" height="459" class="relative mx-auto mt-10 w-[92%]" data-ritratto />
            <span class="scan absolute inset-x-0 top-0 h-0.5 bg-brand2" aria-hidden="true" data-scan></span>
            <p class="absolute left-5 top-5 font-mono text-[11px] uppercase tracking-[0.2em] text-white/80">CTO · Torino</p>
          </div>
        </div>
      </div>
      <div class="relative border-t border-white/10">
        <dl class="mx-auto grid max-w-7xl grid-cols-3 divide-x divide-white/10 px-4 sm:px-8">
          {x.numeri.map((n: any) => <div class="px-3 py-6 sm:px-8"><dt class="sr-only">{n.testo}</dt><dd class="font-head text-[2.2rem] font-extrabold leading-none text-brand2 sm:text-[3.2rem]"><span data-conta={n.valore}>{n.valore}</span>{n.suffisso}</dd><p class="mt-2 text-[12.5px] leading-snug text-deep-ink sm:text-[14px]" aria-hidden="true">{n.testo}</p></div>)}
        </dl>
      </div>
    </section>

    <!-- PRENOTAZIONE -->
    <section id="prenota-box" class="px-4 py-12 sm:px-8 sm:py-16" data-prenota-box data-mail={mail} data-oggetto={m.prenota.oggettoMail} data-sede={sede.frase} data-esami={ESAMI}>
      <div class="mx-auto grid max-w-7xl overflow-hidden rounded-2xl border border-line lg:grid-cols-12">
        <div class="border-l-8 border-brand p-6 sm:p-8 lg:col-span-7">
          <h2 class="font-head text-[2rem] font-extrabold leading-tight tracking-tight">Prenoti una visita</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <label class="block"><span class="font-mono text-[11.5px] uppercase tracking-[0.16em] text-muted">Motivo</span>
              <select class="campo mt-1.5" data-motivo>{box.motivi.map((t: string, i: number) => <option value={box.motiviFrase[i]}>{t}</option>)}</select></label>
            <div><span class="font-mono text-[11.5px] uppercase tracking-[0.16em] text-muted">Dove</span>
              <p class="mt-1.5 flex min-h-[48px] items-center gap-2 rounded-xl bg-surface px-4 text-[15px] font-semibold"><Icona nome="pin" class="h-4 w-4 text-brand" />{sede.nome}, {sede.indirizzo}</p></div>
          </div>
          <label class="interruttore mt-5 flex cursor-pointer items-center gap-3">
            <input type="checkbox" class="peer sr-only" data-ho-esami />
            <span class="relative h-7 w-12 shrink-0 rounded-full bg-line transition-colors peer-checked:bg-brand peer-focus-visible:ring-2 peer-focus-visible:ring-brand2"><span class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow transition-[translate] peer-checked:translate-x-5" data-pallino></span></span>
            <span class="text-[15.5px] font-semibold">Ho già degli esami (radiografia, TC o risonanza)</span>
          </label>
        </div>
        <div class="flex flex-col justify-between gap-5 bg-deep p-6 text-white sm:p-8 lg:col-span-5">
          <p class="font-mono text-[11.5px] uppercase tracking-[0.16em] text-brand2">Anteprima del messaggio</p>
          <p class="font-head text-[1.2rem] font-semibold leading-snug" data-anteprima aria-live="polite">{testo(box.motiviFrase[0])}</p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href={href0} data-prenota class="btn flex-1 !rounded-lg bg-brand text-white hover:opacity-90"><Icona nome="mail" /> Invii la mail</a>
            <a href={telHref(m.prenota.telefono)} class="btn flex-1 !rounded-lg border border-white/30 text-white hover:bg-white/10"><Icona nome="tel" /> {m.prenota.telefonoLabel}</a>
          </div>
          <p class="flex items-start gap-2 text-[12px] text-white/60"><img src="/pragma-logo-sm.png" alt="" width="14" height="14" class="mt-px h-3.5 w-3.5" />{x.prenota.notaRichieste}</p>
        </div>
      </div>
    </section>

    <!-- DOVE FA MALE: scheletro -->
    <section id="aree" class="griglia-lastra bg-deep px-4 py-16 text-white sm:px-8 sm:py-24" data-scheletro data-dati={JSON.stringify(regioni)}>
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[4rem]" data-sale>Dove fa male?</h2>
          <p class="max-w-md text-[16px] text-deep-ink">Tocchi una zona: Le spiego quali tumori vi nascono più spesso e come intervengo.</p>
        </div>
        <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-center">
          <ul class="order-2 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:order-1 lg:col-span-3 lg:grid-cols-1" role="tablist" aria-label="Zone del corpo">
            {regioni.map((r, i) => <li><button type="button" role="tab" id={`zona-${r.id}`} aria-controls="zona-pannello" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="zona-tab w-full rounded-lg border border-white/15 px-4 py-2.5 text-left text-[15px] font-semibold" data-zona-tab={i}>{r.nome}</button></li>)}
          </ul>
          <div class="relative order-1 mx-auto w-full max-w-[300px] lg:order-2 lg:col-span-4">
            <svg viewBox="0 0 200 440" class="w-full" aria-hidden="true" data-figura>
              <g fill="none" stroke="var(--c-brand2)" stroke-linecap="round" stroke-linejoin="round" class="ossa">
                <ellipse cx="100" cy="32" rx="21" ry="25" stroke-width="3" />
                <path d="M86 50 Q100 62 114 50" stroke-width="3" />
                <g data-osso="colonna">{vert.map((y) => <rect x="95.5" y={y} width="9" height="6" rx="2" stroke-width="2.4" />)}</g>
                <path d="M100 78 C74 80 66 96 68 112 C70 130 80 142 96 146 M100 78 C126 80 134 96 132 112 C130 130 120 142 104 146" stroke-width="2.6" />
                <path d="M80 92 C88 96 94 96 98 96 M120 92 C112 96 106 96 102 96 M76 106 C86 112 94 112 98 112 M124 106 C114 112 106 112 102 112 M78 122 C88 128 94 128 98 128 M122 122 C112 128 106 128 102 128" stroke-width="2" />
                <path d="M100 70 L62 76 M100 70 L138 76" stroke-width="3" />
                <g data-osso="spalla"><circle cx="58" cy="82" r="8" stroke-width="3" /><circle cx="142" cy="82" r="8" stroke-width="3" /><path d="M56 90 L47 168 M144 90 L153 168" stroke-width="7" /></g>
                <path d="M47 170 L36 252 M51 172 L44 254 M153 170 L164 252 M149 172 L156 254" stroke-width="3.2" />
                <path d="M36 258 l-6 22 M40 258 l-2 24 M44 258 l3 22 M164 258 l6 22 M160 258 l2 24 M156 258 l-3 22" stroke-width="2.2" />
                <path d="M72 208 C66 222 70 238 84 246 L100 236 L116 246 C130 238 134 222 128 208 C118 216 108 220 100 220 C92 220 82 216 72 208 Z" stroke-width="3" data-osso="bacino" />
                <g data-osso="femore"><circle cx="82" cy="244" r="7" stroke-width="3" /><circle cx="118" cy="244" r="7" stroke-width="3" /><path d="M80 252 L79 280 M120 252 L121 280" stroke-width="8" /></g>
                <g data-osso="diafisi"><path d="M79 282 L78 318 M121 282 L122 318" stroke-width="8" /><path d="M80 356 L81 410 M120 356 L119 410" stroke-width="7" /></g>
                <g data-osso="ginocchio"><path d="M78 320 L78 334 M122 320 L122 334" stroke-width="10" /><circle cx="79" cy="340" r="5" stroke-width="2.6" /><circle cx="121" cy="340" r="5" stroke-width="2.6" /><path d="M80 346 L80 354 M120 346 L120 354" stroke-width="9" /></g>
                <path d="M81 412 L72 428 L92 430 M119 412 L128 428 L108 430" stroke-width="3" />
                <ellipse cx="122" cy="290" rx="17" ry="38" stroke-width="2" stroke-dasharray="4 4" data-osso="molli" />
              </g>
            </svg>
            {regioni.map((r, i) => <button type="button" class="punto-zona absolute grid h-7 w-7 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full" style={`left:${punti[r.id][0]}%;top:${punti[r.id][1]}%`} aria-label={r.nome} data-zona-punto={i}><span class="h-3 w-3 rounded-full bg-white"></span></button>)}
          </div>
          <div id="zona-pannello" role="tabpanel" class="order-3 rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 sm:p-8 lg:col-span-5" aria-live="polite" data-zona-pannello>
            <p class="font-mono text-[11.5px] uppercase tracking-[0.18em] text-brand2">Zona selezionata</p>
            <h3 class="mt-2 font-head text-[1.9rem] font-extrabold leading-tight" data-zona-titolo>{regioni[0].titolo}</h3>
            <p class="mt-3 text-[16.5px] leading-relaxed text-deep-ink" data-zona-testo>{regioni[0].testo}</p>
            <p class="mt-5 font-mono text-[11.5px] uppercase tracking-[0.18em] text-brand2">Come intervengo</p>
            <p class="mt-2 text-[16.5px] leading-relaxed text-white" data-zona-faccio>{regioni[0].faccio}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- QUANDO INDAGARE -->
    <section id="segnali" class="px-4 py-16 sm:px-8 sm:py-24" data-segnali>
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[3.6rem]" data-sale>Quando un dolore osseo va indagato</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-ink/80">La maggior parte dei dolori alle ossa è meccanica e migliora con il riposo. Spunti quello che Le corrisponde.</p>
          <div class="mt-8 rounded-2xl bg-deep p-6 text-white sm:p-8" data-esito>
            <p class="font-head text-[3.6rem] font-extrabold leading-none text-brand2"><span data-segnali-n>0</span><span class="text-[1.5rem] text-deep-ink"> / {x.segnali.length}</span></p>
            <p class="mt-3 font-head text-[1.35rem] font-bold" data-esito-titolo aria-live="polite">Nessun segnale spuntato</p>
            <p class="mt-2 text-[15.5px] leading-relaxed text-deep-ink" data-esito-testo>Se il dolore è legato agli sforzi e passa con il riposo, di solito non è preoccupante.</p>
            <button type="button" class="btn mt-5 hidden !rounded-lg bg-brand text-white hover:opacity-90" data-esito-prenota><Icona nome="calendario" /> Prenoti una valutazione</button>
          </div>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7" data-lista-segnali>
          {(x.segnali as string[]).map((s, i) => (
            <li><label class="segnale flex h-full cursor-pointer items-start gap-4 rounded-2xl border-2 border-line p-5">
              <input type="checkbox" class="mt-1 h-5 w-5 shrink-0 accent-[var(--c-brand)]" data-segnale={i} />
              <span class="text-[16.5px] font-semibold leading-snug">{s}</span></label></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- IL PERCORSO -->
    <section id="percorso" class="bg-surface px-4 py-16 sm:px-8 sm:py-24" data-percorso data-dati={JSON.stringify(x.percorso)}>
      <div class="mx-auto max-w-7xl">
        <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[3.6rem]" data-sale>Il percorso, passo per passo</h2>
        <div class="relative mt-12">
          <span class="absolute left-0 right-0 top-[22px] h-1 rounded-full bg-line" aria-hidden="true"></span>
          <span class="absolute left-0 top-[22px] h-1 w-0 rounded-full bg-brand" aria-hidden="true" data-percorso-linea></span>
          <ol class="relative grid grid-cols-6 gap-1" role="tablist" aria-label="Il percorso">
            {(x.percorso as any[]).map((p, i) => <li class="flex justify-center"><button type="button" role="tab" id={`passo-${i}`} aria-controls="passo-pannello" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tappa-btn flex flex-col items-center gap-2" data-tappa-btn={i}><span class="tappa-nodo grid h-12 w-12 place-items-center rounded-full border-4 border-surface font-head text-[15px] font-extrabold">{i + 1}</span><span class="hidden text-[14px] font-bold sm:block">{p.nome}</span></button></li>)}
          </ol>
        </div>
        <div id="passo-pannello" role="tabpanel" class="mt-8 grid gap-6 rounded-2xl bg-white p-6 sm:p-10 md:grid-cols-12 md:items-center" data-passo-pannello>
          <p class="font-head text-[5rem] font-extrabold leading-none text-brand/15 md:col-span-2" data-passo-num aria-hidden="true">01</p>
          <div class="md:col-span-8"><h3 class="font-head text-[1.9rem] font-extrabold" data-passo-nome>{x.percorso[0].nome}</h3><p class="mt-2 text-[17px] leading-relaxed text-ink/85" data-passo-testo aria-live="polite">{x.percorso[0].testo}</p></div>
          <div class="flex gap-2 md:col-span-2 md:justify-end">
            <button type="button" class="grid h-12 w-12 place-items-center rounded-lg border border-line hover:bg-surface" data-passo-prev aria-label="Passo precedente"><Icona nome="sx" /></button>
            <button type="button" class="grid h-12 w-12 place-items-center rounded-lg bg-brand text-white hover:opacity-90" data-passo-next aria-label="Passo successivo"><Icona nome="dx" /></button>
          </div>
        </div>
      </div>
    </section>

    <!-- RICOSTRUIRE: titanio o carbonio -->
    <section id="ricostruire" class="griglia-lastra bg-deep px-4 py-16 text-white sm:px-8 sm:py-24" data-materiale>
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[3.6rem]" data-sale>Ricostruire, e poi vedere</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-deep-ink">Dopo l'asportazione del tumore l'osso va ricostruito. Ma serve anche poterlo controllare negli anni. Guardi come appare una placca ai raggi X.</p>
          <div class="mt-6 inline-flex rounded-xl bg-white/10 p-1" role="group" aria-label="Materiale della placca">
            <button type="button" class="materiale-btn rounded-lg px-5 py-2.5 text-[15px] font-bold" data-mat="titanio" aria-pressed="true">Titanio</button>
            <button type="button" class="materiale-btn rounded-lg px-5 py-2.5 text-[15px] font-bold" data-mat="carbonio" aria-pressed="false">Fibra di carbonio</button>
          </div>
          <p class="mt-5 min-h-[5.5rem] text-[16.5px] leading-relaxed" data-mat-testo aria-live="polite">Il metallo blocca i raggi X: la placca appare bianca e nasconde l'osso che sta sotto. In TC e risonanza crea artefatti.</p>
        </div>
        <figure class="lg:col-span-7">
          <div class="relative mx-auto aspect-[16/9] max-w-[640px] overflow-hidden rounded-2xl bg-black ring-1 ring-white/10">
            <svg viewBox="0 0 640 360" class="h-full w-full" role="img" aria-label="Schema di un femore con una placca, come appare ai raggi X" data-rx>
              <path d="M40 150 C120 132 200 140 320 144 C440 148 520 136 600 150 L600 214 C520 228 440 216 320 220 C200 224 120 232 40 214 Z" fill="#9aa7b8" opacity=".55" />
              <path d="M40 162 C120 148 200 154 320 158 C440 162 520 152 600 162 L600 202 C520 214 440 204 320 206 C200 210 120 216 40 202 Z" fill="#1d2633" opacity=".85" />
              <path d="M300 150 C312 170 296 190 310 214" stroke="#e8f2ff" stroke-width="2" fill="none" stroke-dasharray="5 4" />
              <circle cx="332" cy="182" r="20" fill="none" stroke="#7CC8FF" stroke-width="2" opacity=".9" />
              <g data-placca>
                <rect x="150" y="118" width="340" height="30" rx="12" data-placca-corpo />
                {[180, 230, 280, 360, 410, 460].map((cx) => <g><rect x={cx - 5} y="110" width="10" height="130" rx="4" data-vite /></g>)}
              </g>
              <g data-artefatti stroke="#fff" opacity=".35">{[0, 1, 2, 3, 4, 5].map((i) => <line x1={170 + i * 60} y1="40" x2={150 + i * 64} y2="330" stroke-width="1.2" />)}</g>
            </svg>
          </div>
          <figcaption class="mt-3 text-center text-[13px] text-deep-ink/70">Schema illustrativo, non un'immagine di un paziente.</figcaption>
        </figure>
      </div>
      <div class="mx-auto mt-14 grid max-w-7xl gap-4 md:grid-cols-3" data-stagger>
        {(x.tecniche as any[]).map((t) => <article class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10"><h3 class="font-head text-[1.4rem] font-extrabold text-brand2">{t.nome}</h3><p class="mt-2 text-[15.5px] leading-relaxed text-deep-ink">{t.testo}</p></article>)}
      </div>
    </section>

    <!-- CHI SONO: pellicola -->
    <section id="chi-sono" class="overflow-hidden px-4 py-16 sm:px-8 sm:py-24" data-cv>
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[3.6rem]" data-sale>Chi sono</h2>
            <p class="mt-5 text-[17px] leading-relaxed text-ink/85">Dopo la specializzazione in patologia traumatica e degenerativa muscolo-scheletrica, ho dedicato la mia attività clinica e scientifica alla chirurgia ortopedica oncologica al CTO di Torino, dove opero come Dirigente Medico.</p>
            <p class="mt-3 text-[17px] leading-relaxed text-ink/85">Mi sono formato in centri di riferimento come l'Inselspital di Berna, l'Istituto Ortopedico Rizzoli di Bologna e l'Hospital Universitari Sant Joan de Reus. Lavoro con tecniche mini-invasive e ricostruttive, incluse protesi custom made e mezzi di sintesi in fibra di carbonio, spesso con équipe multidisciplinari.</p>
          </div>
          <div class="lg:col-span-7">
            <div class="flex flex-wrap gap-2">{(x.societa as string[]).map((s) => <span class="rounded-md bg-surface px-3 py-1.5 font-mono text-[13px] font-semibold text-brand">Socio {s}</span>)}</div>
            <a href={x.recensioniTd.url} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-3 rounded-xl border border-line px-4 py-3 hover:bg-surface"><span class="flex gap-0.5 text-brand">{[0, 1, 2, 3, 4].map(() => <Icona nome="stella" class="h-4 w-4 fill-current" />)}</span><span class="text-[15px]"><b>{x.recensioniTd.media}/5</b> su {x.recensioniTd.fonte} · {x.recensioniTd.numero} recensioni</span></a>
            <p class="mt-6 text-[15px] text-muted">Autore di oltre 20 pubblicazioni scientifiche e di circa 40 comunicazioni e poster.</p>
          </div>
        </div>
        <div class="mt-10 flex items-center justify-between gap-4">
          <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-muted">La mia formazione · la trascini</p>
          <div class="flex gap-2"><button type="button" class="grid h-11 w-11 place-items-center rounded-lg border border-line hover:bg-surface" data-cv-prev aria-label="Indietro"><Icona nome="sx" /></button><button type="button" class="grid h-11 w-11 place-items-center rounded-lg bg-deep text-white hover:opacity-90" data-cv-next aria-label="Avanti"><Icona nome="dx" /></button></div>
        </div>
        <ol class="pellicola -mx-4 mt-5 flex snap-x gap-0 overflow-x-auto bg-deep px-4 py-6 sm:mx-0 sm:rounded-2xl sm:px-6" tabindex="0" aria-label="La mia formazione" data-pista>
          {(x.cv as any[]).map((c) => (
            <li class="fotogramma w-[78%] shrink-0 snap-start px-2 sm:w-[44%] lg:w-[30%]">
              <div class="h-full rounded-lg bg-[#16223A] p-5 text-white">
                <p class="font-mono text-[12px] uppercase tracking-[0.16em] text-brand2">{c.anno || '—'} · {c.luogo}</p>
                <h3 class="mt-2 font-head text-[1.35rem] font-extrabold leading-tight">{c.titolo}</h3>
                <p class="mt-2 text-[14.5px] leading-relaxed text-deep-ink">{c.testo}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- OSPEDALE -->
    <section class="relative overflow-hidden bg-deep text-white">
      <img src={foto.sala} alt="" width="1600" height="1000" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-35" data-parallasse />
      <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-8 sm:py-28">
        <p class="font-mono text-[12px] uppercase tracking-[0.2em] text-brand2">Dove opero</p>
        <h2 class="mt-3 max-w-3xl font-head text-[2.2rem] font-extrabold leading-tight tracking-tight sm:text-[3.2rem]" data-sale>{x.ospedale.reparto}, {x.ospedale.nome}</h2>
        <p class="mt-4 max-w-2xl text-[17px] text-deep-ink">{x.ospedale.indirizzo}. Il percorso in ospedale si concorda dopo la visita, insieme all'équipe multidisciplinare.</p>
      </div>
    </section>

    <div class="stile-radiografia bg-surface"><PrenotaCalendario m={m} /></div>

    <!-- BLOG + IG -->
    <section id="articoli" class="px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[3.6rem]" data-sale>Da leggere</h2>
          <a href={`/${m.slug}/blog`} class="inline-flex items-center gap-2 font-semibold text-brand hover:underline">Tutti gli articoli <Icona nome="freccia" class="h-4 w-4" /></a>
        </div>
        <ol class="mt-10 divide-y divide-line border-y border-line" data-blog>
          {blog.map((b, i) => (
            <li><a href={b.href} class="articolo-riga group grid items-center gap-4 py-6 sm:grid-cols-12">
              <span class="font-mono text-[13px] text-muted sm:col-span-1">0{i + 1}</span>
              <span class="sm:col-span-7"><span class="font-mono text-[11.5px] uppercase tracking-[0.16em] text-brand">{b.categoria} · {b.tempoLettura}</span><span class="mt-1 block font-head text-[1.5rem] font-extrabold leading-tight group-hover:text-brand sm:text-[1.9rem]">{b.titolo}</span></span>
              <span class="hidden overflow-hidden rounded-xl sm:col-span-4 sm:block"><img src={b.img} alt="" width="1400" height="1000" loading="lazy" class="aspect-[16/9] w-full object-cover grayscale transition-[filter,scale] duration-500 group-hover:scale-105 group-hover:grayscale-0" /></span>
            </a></li>
          ))}
        </ol>

        <div class="mt-20 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="font-head text-[2.4rem] font-extrabold tracking-tight" data-sale>Su Instagram</h2>
          <p class="inline-flex w-fit items-center gap-2 rounded-full bg-surface px-3 py-1.5 text-xs text-muted"><img src="/pragma-logo-sm.png" alt="" width="14" height="14" class="h-3.5 w-3.5" /> Proposta Pragma: {ig.nota}</p>
        </div>
        <div class="-mx-4 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-3 lg:overflow-visible" data-stagger>
          {ig.post.map((p: any) => (
            <article class="w-[84%] shrink-0 snap-center overflow-hidden rounded-2xl border border-line bg-white sm:w-[60%] lg:w-auto">
              <header class="flex items-center gap-3 px-4 py-3"><img src={foto.volto} alt="" width="32" height="32" class="h-8 w-8 rounded-full object-cover" /><span class="text-sm font-semibold">{ig.handle}</span></header>
              {p.stile === 'foto' && (
                <div class="relative aspect-square overflow-hidden bg-surface">
                  <img src={foto[p.immagine]} alt="" width="1200" height="1400" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                  <div class="absolute inset-x-0 bottom-0 bg-deep/95 px-5 py-4 text-white"><p class="font-head text-[1.7rem] font-extrabold leading-tight">{p.titolo}</p><p class="mt-0.5 text-sm text-brand2">{p.sottotitolo}</p></div>
                </div>
              )}
              {p.stile === 'domanda' && (
                <div class="griglia-lastra flex aspect-square flex-col justify-between bg-deep p-7 text-white">
                  <span class="font-mono text-[13px] uppercase tracking-[0.2em] text-brand2">Domanda</span>
                  <div><p class="font-head text-[2rem] font-extrabold leading-[1.02]">{p.titolo}</p><p class="mt-4 w-fit rounded-md bg-brand px-4 py-2 text-[14px] font-semibold">{p.risposta}</p></div>
                </div>
              )}
              {p.stile === 'lista' && (
                <div class="flex aspect-square flex-col justify-center bg-brand p-7 text-white">
                  <p class="font-head text-[1.85rem] font-extrabold leading-[1.02]">{p.titolo}</p>
                  <ul class="mt-5 space-y-2">{p.punti.map((t: string) => <li class="flex items-start gap-2.5 text-[15px]"><span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-sm bg-brand2"></span>{t}</li>)}</ul>
                </div>
              )}
              <p class="px-4 py-4 text-[13px] leading-relaxed text-ink/80"><span class="font-semibold">{ig.handle}</span> {p.didascalia} <span class="text-brand">{p.hashtag}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SEDE -->
    <section id="sedi" class="bg-surface px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="font-head text-[2.4rem] font-extrabold leading-none tracking-tight sm:text-[3.6rem]" data-sale>{m.sedi.titolo}</h2>
          <p class="mt-4 text-[17px] text-ink/80">Visite private su appuntamento. Porti con sé immagini e referti degli esami già fatti.</p>
        </div>
        <article class="rounded-2xl bg-white p-7 lg:col-span-7" data-stagger>
          <div><h3 class="font-head text-[1.7rem] font-extrabold">{sede.nome}</h3><p class="mt-1 text-[16px] text-muted">{sede.indirizzo}, {sede.cap} {sede.citta}</p></div>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2"><a href={telHref(m.prenota.telefono)} class="inline-flex items-center gap-2 font-semibold text-brand hover:underline"><Icona nome="tel" class="h-4 w-4" />{m.prenota.telefonoLabel}</a><a href={mapsHref(sede.indirizzo, sede.citta)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-brand hover:underline"><Icona nome="pin" class="h-4 w-4" /> Apra la mappa</a></div>
          <p class="mt-5 border-t border-line pt-5 text-[15px] text-ink/75">In ospedale: {x.ospedale.reparto}, {x.ospedale.nome}, {x.ospedale.indirizzo}.</p>
        </article>
      </div>
    </section>

    <section class="griglia-lastra bg-deep px-4 py-14 text-white sm:px-8">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div><h2 class="font-head text-[2.4rem] font-extrabold tracking-tight sm:text-5xl">{m.prenota.titolo}</h2><p class="mt-2 max-w-xl text-deep-ink">{m.prenota.testo}</p></div>
        <div class="flex shrink-0 flex-col gap-3 whitespace-nowrap sm:flex-row">
          <a href={telHref(m.prenota.telefono)} class="btn !rounded-lg bg-brand text-white hover:opacity-90"><Icona nome="tel" /> {m.prenota.telefonoLabel}</a>
          <a href="#prenota" class="btn !rounded-lg border border-white/40 text-white hover:bg-white/10"><Icona nome="calendario" /> Scelga giorno e orario</a>
        </div>
      </div>
    </section>
  </main>

  <Footer m={m} />
  <CtaMobile m={m} />
  <script>
    import '../scripts/motion.ts';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';
    gsap.registerPlugin(ScrollTrigger);
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.toggle('senza-moto', ridotto);
    let lenis: Lenis | null = null;
    const vaiA = (sel: string) => { const el = document.querySelector<HTMLElement>(sel)!; const y = el.getBoundingClientRect().top + window.scrollY - 110; if (lenis) lenis.scrollTo(y); else window.scrollTo({ top: y, behavior: 'auto' }); };

    // --- Prenotazione ---
    const box = document.querySelector<HTMLElement>('[data-prenota-box]')!;
    const sel = box.querySelector<HTMLSelectElement>('[data-motivo]')!;
    const esami = box.querySelector<HTMLInputElement>('[data-ho-esami]')!;
    const aggiorna = () => {
      const t = `Buongiorno Dottore, vorrei prenotare una visita per ${sel.value} presso ${box.dataset.sede}.${esami.checked ? box.dataset.esami : ''}`;
      box.querySelector('[data-anteprima]')!.textContent = t;
      box.querySelector<HTMLAnchorElement>('[data-prenota]')!.href = `mailto:${box.dataset.mail}?subject=${encodeURIComponent(box.dataset.oggetto!)}&body=${encodeURIComponent(t)}`;
      if (!ridotto) gsap.fromTo('[data-anteprima]', { opacity: 0.3, y: 6 }, { opacity: 1, y: 0, duration: 0.3 });
    };
    sel.addEventListener('change', aggiorna); esami.addEventListener('change', aggiorna);
    const prenotaPer = (indice: number) => { sel.selectedIndex = indice; aggiorna(); vaiA('#prenota-box'); sel.focus({ preventScroll: true }); };

    // --- Dove fa male ---
    const sk = document.querySelector<HTMLElement>('[data-scheletro]')!;
    const RE = JSON.parse(sk.dataset.dati!) as { id: string; titolo: string; testo: string; faccio: string }[];
    const ztab = [...sk.querySelectorAll<HTMLElement>('[data-zona-tab]')];
    const zpunti = [...sk.querySelectorAll<HTMLElement>('[data-zona-punto]')];
    let zAtt = 0;
    const zona = (i: number, focus = false) => {
      const r = RE[i];
      ztab.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      zpunti.forEach((p, k) => p.classList.toggle('attivo', k === i));
      sk.querySelectorAll<SVGElement>('[data-osso]').forEach((o) => o.classList.toggle('acceso', o.dataset.osso === r.id));
      sk.querySelector('[data-zona-titolo]')!.textContent = r.titolo;
      sk.querySelector('[data-zona-testo]')!.textContent = r.testo;
      sk.querySelector('[data-zona-faccio]')!.textContent = r.faccio;
      sk.querySelector('[data-zona-pannello]')!.setAttribute('aria-labelledby', ztab[i].id);
      if (!ridotto) gsap.fromTo('[data-zona-pannello] > *', { x: 16, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, stagger: 0.04 });
      sk.dataset.zona = r.id; zAtt = i;
      if (focus) ztab[i].focus();
    };
    ztab.forEach((t, i) => {
      t.addEventListener('click', () => zona(i));
      t.addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key, n = ztab.length; if (k === 'ArrowDown' || k === 'ArrowRight') { e.preventDefault(); zona((zAtt + 1) % n, true); } if (k === 'ArrowUp' || k === 'ArrowLeft') { e.preventDefault(); zona((zAtt + n - 1) % n, true); } });
    });
    zpunti.forEach((p, i) => p.addEventListener('click', () => zona(i)));
    zona(0);

    // --- Segnali ---
    const sg = document.querySelector<HTMLElement>('[data-segnali]')!;
    const cb = [...sg.querySelectorAll<HTMLInputElement>('[data-segnale]')];
    const btnEs = sg.querySelector<HTMLElement>('[data-esito-prenota]')!;
    const calcola = () => {
      const n = cb.filter((c) => c.checked).length, storia = cb[cb.length - 1].checked;
      sg.querySelector('[data-segnali-n]')!.textContent = String(n);
      cb.forEach((c) => c.closest('.segnale')!.classList.toggle('spuntato', c.checked));
      const [t, d] = n === 0 ? ['Nessun segnale spuntato', 'Se il dolore è legato agli sforzi e passa con il riposo, di solito non è preoccupante.']
        : n === 1 && !storia ? ['Un segnale da tenere d\'occhio', 'Se il dolore continua per qualche settimana, ne parli con il Suo medico: una radiografia può bastare a chiarire.']
        : ['Merita un approfondimento', 'Questi segnali insieme vanno valutati: il primo passo è una radiografia, poi una visita specialistica. Non significa tumore, ma è il momento di capire.'];
      sg.querySelector('[data-esito-titolo]')!.textContent = t;
      sg.querySelector('[data-esito-testo]')!.textContent = d;
      btnEs.classList.toggle('hidden', n === 0);
      sg.dataset.livello = n === 0 ? '0' : n === 1 && !storia ? '1' : '2';
      if (!ridotto) gsap.fromTo('[data-segnali-n]', { scale: 1.3 }, { scale: 1, duration: 0.3 });
    };
    cb.forEach((c) => c.addEventListener('change', calcola));
    btnEs.addEventListener('click', () => prenotaPer(0));

    // --- Percorso a tappe ---
    const pc = document.querySelector<HTMLElement>('[data-percorso]')!;
    const PA = JSON.parse(pc.dataset.dati!) as { nome: string; testo: string }[];
    const tbtn = [...pc.querySelectorAll<HTMLElement>('[data-tappa-btn]')];
    let pAtt = 0;
    const passo = (i: number, focus = false) => {
      const n = PA.length; i = (i + n) % n;
      tbtn.forEach((b, k) => { b.setAttribute('aria-selected', String(k === i)); b.tabIndex = k === i ? 0 : -1; b.classList.toggle('fatto', k <= i); });
      pc.querySelector('[data-passo-nome]')!.textContent = PA[i].nome;
      pc.querySelector('[data-passo-testo]')!.textContent = PA[i].testo;
      pc.querySelector('[data-passo-num]')!.textContent = String(i + 1).padStart(2, '0');
      pc.querySelector('[data-passo-pannello]')!.setAttribute('aria-labelledby', `passo-${i}`);
      const w = `${(i / (n - 1)) * 100}%`; const linea = pc.querySelector<HTMLElement>('[data-percorso-linea]')!;
      if (ridotto) linea.style.width = w; else gsap.to(linea, { width: w, duration: 0.6, ease: 'power2.out' });
      if (!ridotto) gsap.fromTo('[data-passo-pannello] h3, [data-passo-pannello] p', { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, stagger: 0.05 });
      pc.dataset.passo = String(i); pAtt = i;
      if (focus) tbtn[i].focus();
    };
    tbtn.forEach((b, i) => {
      b.addEventListener('click', () => passo(i));
      b.addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key; if (k === 'ArrowRight') { e.preventDefault(); passo(pAtt + 1, true); } if (k === 'ArrowLeft') { e.preventDefault(); passo(pAtt - 1, true); } });
    });
    pc.querySelector('[data-passo-next]')!.addEventListener('click', () => passo(pAtt + 1));
    pc.querySelector('[data-passo-prev]')!.addEventListener('click', () => passo(pAtt - 1));
    passo(0);

    // --- Titanio o carbonio ---
    const mt = document.querySelector<HTMLElement>('[data-materiale]')!;
    const TESTI: Record<string, string> = {
      titanio: "Il metallo blocca i raggi X: la placca appare bianca e nasconde l'osso che sta sotto. In TC e risonanza crea artefatti.",
      carbonio: "La fibra di carbonio lascia passare i raggi X: si vedono l'osso e la zona trattata, e i controlli con TC e risonanza sono più chiari. Aiuta anche a pianificare la radioterapia."
    };
    const materiale = (id: string) => {
      mt.querySelectorAll<HTMLElement>('[data-mat]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mat === id)));
      mt.querySelector('[data-mat-testo]')!.textContent = TESTI[id];
      const carb = id === 'carbonio';
      const els = mt.querySelectorAll<SVGElement>('[data-placca-corpo], [data-vite]');
      const st = carb ? { fill: 'rgba(124,200,255,0.06)', stroke: '#7CC8FF', strokeWidth: 1.5 } : { fill: '#ffffff', stroke: '#ffffff', strokeWidth: 0 };
      if (ridotto) els.forEach((e) => { e.setAttribute('fill', st.fill); e.setAttribute('stroke', st.stroke); e.setAttribute('stroke-width', String(st.strokeWidth)); });
      else gsap.to(els, { attr: { fill: st.fill, stroke: st.stroke, 'stroke-width': st.strokeWidth }, duration: 0.6 });
      const art = mt.querySelector<SVGElement>('[data-artefatti]')!;
      if (ridotto) art.setAttribute('opacity', carb ? '0' : '0.35'); else gsap.to(art, { attr: { opacity: carb ? 0 : 0.35 }, duration: 0.6 });
      mt.dataset.mat = id;
    };
    mt.querySelectorAll<HTMLElement>('[data-mat]').forEach((b) => b.addEventListener('click', () => materiale(b.dataset.mat!)));
    materiale('titanio');

    // --- Pellicola ---
    const pista = document.querySelector<HTMLElement>('[data-pista]')!;
    const passoPx = () => (pista.querySelector('li') as HTMLElement).offsetWidth;
    document.querySelector('[data-cv-next]')!.addEventListener('click', () => pista.scrollBy({ left: passoPx(), behavior: ridotto ? 'auto' : 'smooth' }));
    document.querySelector('[data-cv-prev]')!.addEventListener('click', () => pista.scrollBy({ left: -passoPx(), behavior: ridotto ? 'auto' : 'smooth' }));
    let giu = false, x0 = 0, s0 = 0;
    pista.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; giu = true; x0 = e.clientX; s0 = pista.scrollLeft; pista.classList.add('trascina'); });
    window.addEventListener('pointermove', (e) => { if (giu) pista.scrollLeft = s0 - (e.clientX - x0); });
    window.addEventListener('pointerup', () => { giu = false; pista.classList.remove('trascina'); });

    if (!ridotto) {
      lenis = new Lenis({ anchors: { offset: -100 }, lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis!.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
      const h = document.querySelector<HTMLElement>('[data-titolo-hero]')!;
      const parole = (h.textContent ?? '').trim().split(/\s+/);
      h.setAttribute('aria-label', parole.join(' '));
      h.innerHTML = parole.map((w, i) => `<span class="inline-block overflow-hidden pb-[0.06em] align-bottom" aria-hidden="true"><span class="inline-block ${i >= 3 ? 'text-brand2' : ''}">${w}</span></span>`).join(' ');
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      // la linea di scansione scende e rivela la foto
      tl.set('[data-ritratto]', { clipPath: 'inset(0 0 100% 0)' })
        .to('[data-scan]', { top: '100%', duration: 1.6, ease: 'power2.inOut' }, 0.2)
        .to('[data-ritratto]', { clipPath: 'inset(0 0 0% 0)', duration: 1.6, ease: 'power2.inOut' }, 0.2)
        .to('[data-scan]', { opacity: 0, duration: 0.3 })
        .from(h.querySelectorAll(':scope > span > span'), { yPercent: 110, duration: 0.8, stagger: 0.06 }, 0.1)
        .from('[data-entra]', { y: 26, opacity: 0, duration: 0.7, stagger: 0.08 }, 0.5);
      document.querySelectorAll<HTMLElement>('[data-conta]').forEach((el) => {
        const fine = Number(el.dataset.conta); const o = { v: 0 };
        gsap.to(o, { v: fine, duration: 1.6, delay: 0.9, ease: 'power2.out', onUpdate: () => { el.textContent = String(Math.round(o.v)); } });
      });
      gsap.utils.toArray<HTMLElement>('[data-sale]').forEach((el) => gsap.from(el, { y: 40, opacity: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } }));
      // lo scheletro si "disegna" come una lastra che si sviluppa
      const ossa = gsap.utils.toArray<SVGGeometryElement>('[data-figura] .ossa *').filter((e) => 'getTotalLength' in e && (e as any).getTotalLength);
      ossa.forEach((o) => { const l = (o as SVGGeometryElement).getTotalLength(); o.style.strokeDasharray = o.getAttribute('stroke-dasharray') ?? `${l}`; if (!o.getAttribute('stroke-dasharray')) o.style.strokeDashoffset = `${l}`; });
      gsap.to(ossa.filter((o) => !o.getAttribute('stroke-dasharray')), { strokeDashoffset: 0, duration: 1.4, stagger: 0.015, ease: 'power2.out', scrollTrigger: { trigger: '[data-figura]', start: 'top 80%', once: true } });
      gsap.from('[data-zona-punto]', { scale: 0, duration: 0.5, stagger: 0.08, delay: 0.8, ease: 'back.out(2)', scrollTrigger: { trigger: '[data-figura]', start: 'top 80%', once: true } });
      gsap.from('[data-lista-segnali] li', { y: 30, opacity: 0, duration: 0.5, stagger: 0.06, scrollTrigger: { trigger: '[data-lista-segnali]', start: 'top 85%', once: true } });
      // il percorso avanza da solo la prima volta
      let toccato = false; pc.addEventListener('pointerdown', () => { toccato = true; }, { once: true });
      ScrollTrigger.create({ trigger: pc, start: 'top 60%', once: true, onEnter: () => { [1, 2, 3, 4, 5].forEach((i) => window.setTimeout(() => { if (!toccato) passo(i); }, 1300 * i)); } });
      gsap.from('[data-pista] > li', { x: 100, opacity: 0, duration: 0.7, stagger: 0.07, scrollTrigger: { trigger: '[data-pista]', start: 'top 88%', once: true } });
      gsap.utils.toArray<HTMLElement>('[data-parallasse]').forEach((im) => gsap.fromTo(im, { yPercent: -10, scale: 1.2 }, { yPercent: 10, scale: 1.2, ease: 'none', scrollTrigger: { trigger: im.parentElement!, start: 'top bottom', end: 'bottom top', scrub: true } }));
      gsap.from('[data-blog] > li', { x: -40, opacity: 0, duration: 0.6, stagger: 0.08, scrollTrigger: { trigger: '[data-blog]', start: 'top 85%', once: true } });
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</Base>

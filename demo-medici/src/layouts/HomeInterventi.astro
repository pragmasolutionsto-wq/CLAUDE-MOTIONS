---
// Layout "interventi" (prima demo: Francesco Valentino). Costruito sul suo sito, che racconta le tecniche chirurgiche:
// logo vero con monogramma, Montserrat come nel suo marchio, blu petrolio + verde acqua del logo, foto vera in sala operatoria.
// Hero diviso con la foto alta, prenotazione a "lista con pallino" e riepilogo che si scrive da solo,
// indice degli interventi con schede alternate, esami in studio, andrologia a griglia, chi sono scuro con la sua frase.
import Base from './Base.astro';
import Icona from '../components/Icona.astro';
import PrenotaCalendario from '../components/PrenotaCalendario.astro';
import Footer from '../components/Footer.astro';
import CtaMobile from '../components/CtaMobile.astro';
import { nomeCompleto, telHref, mapsHref, emailRichieste, type Medico } from '../lib/medici';

interface Props { m: Medico }
const { m } = Astro.props;
const x = m as any;
const foto = x.foto;
const box = x.hero.box;
const luoghi = m.sedi.luoghi as any[];
const email = emailRichieste(m);
const wa = m.prenota.whatsapp ? String(m.prenota.whatsapp).replace(/\D/g, '') : '';
const msg = `Buongiorno Dottore, vorrei prenotare una visita per ${box.motiviFrase[0]} presso ${luoghi[0].frase}.`;
const href0 = wa ? `https://wa.me/${wa}?text=${encodeURIComponent(msg)}` : `mailto:${email}?subject=${encodeURIComponent(m.prenota.oggettoMail)}&body=${encodeURIComponent(msg)}`;
const int = x.interventi;
const immagini: Record<string, string> = { thulep: foto.thulep, prostatectomia: `/${m.slug}/img/sala-equipe.webp`, rirs: `/${m.slug}/img/rep-chirurgo.webp`, urs: `/${m.slug}/img/rep-sala.webp` };
const ig = m.instagram;
const [nome, ...resto] = m.nome.split(' ');
const cognome = resto.join(' ');
const rec = m.recensioni.voci as any[];
---
<Base title={m.meta.title} description={m.meta.description} tema={m.tema}>
  <header class="sticky z-30 border-b border-line bg-white/95 backdrop-blur" style="top: var(--banner-h)">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-8">
      <a href={`/${m.slug}`} class="block shrink-0"><img src={m.brand.logoScuro} alt={m.brand.logoAlt} width="192" height="66" class="h-12 w-auto sm:h-14" /></a>
      <nav class="hidden items-center gap-7 font-head text-[13px] font-medium uppercase tracking-[0.08em] text-ink/70 lg:flex">
        <a href="#aree" class="hover:text-brand">Interventi</a><a href="#andrologia" class="hover:text-brand">Andrologia</a><a href="#chi-sono" class="hover:text-brand">Chi sono</a><a href="#recensioni" class="hover:text-brand">Recensioni</a><a href="#sedi" class="hover:text-brand">Sedi</a>
      </nav>
      <div class="flex items-center gap-4">
        <a href={telHref(m.prenota.telefono)} class="hidden text-right leading-tight md:block"><span class="block text-[11px] uppercase tracking-[0.12em] text-muted">Per appuntamento</span><span class="font-head text-[15px] font-semibold text-brand">{m.prenota.telefonoLabel}</span></a>
        <a href="#prenota-rapida" class="btn btn-primary !min-h-[42px] !rounded-[3px] !px-5 text-sm">Prenoti</a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO diviso: testo + foto alta in sala operatoria -->
    <section data-hero-section class="relative overflow-hidden">
      <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
        <div class="order-2 px-4 pb-12 pt-8 sm:px-8 lg:order-1 lg:col-span-7 lg:py-20 lg:pr-14">
          <p class="flex items-center gap-2.5 font-head text-[12px] font-semibold uppercase tracking-[0.2em] text-brand"><span class="h-2.5 w-2.5 rounded-full bg-brand2"></span>{x.hero.eyebrow}</p>
          <h1 class="mt-6 font-head text-brand">
            <span class="block text-[1.05rem] font-medium tracking-[0.06em] text-muted">{m.titolo}</span>
            <span class="block text-[2.6rem] font-light leading-[1.05] sm:text-[3.6rem]">{nome}</span>
            <span class="block text-[2.6rem] font-medium uppercase leading-[1.05] tracking-[0.05em] sm:text-[3.6rem]">{cognome}</span>
          </h1>
          <p class="mt-8 max-w-xl font-head text-[1.35rem] font-semibold leading-snug text-ink sm:text-[1.6rem]">{x.hero.titolo}</p>
          <p class="mt-4 max-w-xl text-[17px] leading-relaxed text-ink/75">{x.hero.testo}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#prenota-rapida" class="btn btn-primary !rounded-[3px]"><Icona nome="calendario" /> {x.hero.ctaPrenota}</a>
            <a href={telHref(m.prenota.telefono)} class="btn btn-ghost !rounded-[3px]"><Icona nome="tel" /> {m.prenota.telefonoLabel}</a>
          </div>
        </div>
        <div class="relative order-1 lg:order-2 lg:col-span-5">
          <img src={foto.ritrattoLargo} alt={foto.ritrattoAlt} width="1600" height="1200" class="aspect-[4/3] w-full object-cover sm:aspect-[16/10] lg:hidden" style="object-position:50% 30%" />
          <img src={foto.ritratto} alt={foto.ritrattoAlt} width="1500" height="2000" class="hidden h-full max-h-[760px] w-full object-cover lg:block" />
          <span class="absolute -left-5 bottom-16 hidden h-10 w-10 rounded-full border-4 border-white bg-brand2 lg:block" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <!-- PRENOTAZIONE: lista con pallino + riepilogo -->
    <section id="prenota-rapida" class="bg-surface px-4 py-12 sm:px-8 sm:py-16">
      <div class="mx-auto max-w-7xl rounded-[4px] border border-line bg-white p-5 sm:p-8" data-booking data-wa={wa} data-email={email} data-oggetto={m.prenota.oggettoMail}>
        <div class="grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class="font-head text-xl font-semibold text-brand">{box.titolo}</p>
            <p class="mt-1 text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{box.motivoLabel}</p>
            <ul class="mt-4 grid gap-x-6 sm:grid-cols-2" role="radiogroup" aria-label={box.motivoLabel}>
              {box.motivi.map((t: string, i: number) => (
                <li><button type="button" role="radio" data-chip="motivo" data-frase={box.motiviFrase[i]} aria-pressed={i === 0 ? 'true' : 'false'} aria-checked={i === 0 ? 'true' : 'false'} class="voce-pallino flex w-full items-center gap-3 border-b border-line py-3 text-left text-[15px]"><span class="pallino" aria-hidden="true"></span>{t}</button></li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-3">
            <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-muted lg:mt-8">{box.sedeLabel}</p>
            <ul class="mt-4" role="radiogroup" aria-label={box.sedeLabel}>
              {luoghi.map((l, i) => (
                <li><button type="button" role="radio" data-chip="sede" data-frase={l.frase} aria-pressed={i === 0 ? 'true' : 'false'} aria-checked={i === 0 ? 'true' : 'false'} class="voce-pallino flex w-full items-start gap-3 border-b border-line py-3 text-left"><span class="pallino mt-1" aria-hidden="true"></span><span><span class="block text-[15px] font-semibold">{l.nome}</span><span class="block text-[13px] text-muted">{l.indirizzo}</span></span></button></li>
              ))}
            </ul>
          </div>
          <div class="flex flex-col rounded-[4px] bg-deep p-5 text-white lg:col-span-3">
            <p class="text-[12px] font-semibold uppercase tracking-[0.14em] text-brand2">Riepilogo</p>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-deep-ink/90" data-riepilogo aria-live="polite">Visita per {box.motiviFrase[0]}, presso {luoghi[0].frase}.</p>
            <a href={href0} data-prenota target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined} class="btn mt-5 w-full !rounded-[3px] bg-brand2 text-deep hover:opacity-90"><Icona nome={wa ? 'commento' : 'mail'} /> Invii la richiesta</a>
            <a href={telHref(m.prenota.telefono)} class="mt-3 text-center text-[14px] text-deep-ink/75 hover:text-white">oppure chiami il {m.prenota.telefonoLabel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- INTERVENTI -->
    <section id="aree" class="px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-36">
            <h2 class="titolo-sez text-brand" data-reveal>{int.titolo}</h2>
            <p class="mt-5 text-[16px] leading-relaxed text-muted" data-reveal>{int.intro}</p>
            <ul class="mt-8 hidden border-t border-line lg:block">
              {int.voci.map((v: any) => <li><a href={`#${v.id}`} class="flex items-center justify-between gap-3 border-b border-line py-3 text-[15px] hover:text-brand"><span><span class="font-head font-semibold">{v.nome}</span> <span class="text-muted">· {v.patologia}</span></span><Icona nome="dx" class="h-4 w-4 text-brand2" /></a></li>)}
            </ul>
          </div>
        </div>
        <div class="space-y-16 lg:col-span-8">
          {int.voci.map((v: any, i: number) => (
            <article id={v.id} class="scroll-mt-36 border-t-2 border-brand pt-6" data-reveal>
              <p class="font-head text-[12px] font-semibold uppercase tracking-[0.18em] text-brand2">{v.patologia}</p>
              <h3 class="mt-2 font-head text-[1.9rem] font-semibold leading-tight text-brand sm:text-[2.3rem]">{v.nome}</h3>
              <p class="mt-1 font-head text-[15px] text-muted">{v.esteso}</p>
              <div class={`mt-6 grid gap-6 sm:grid-cols-2 sm:items-start ${i % 2 ? 'sm:[&>*:first-child]:order-2' : ''}`}>
                <img src={immagini[v.id]} alt="" width={v.id === 'thulep' ? 514 : 1200} height={v.id === 'thulep' ? 351 : 900} loading="lazy" class="aspect-[4/3] w-full rounded-[3px] object-cover" />
                <div>
                  <p class="text-[16px] leading-relaxed text-ink/85">{v.testo}</p>
                  <ul class="mt-4 space-y-2">{v.punti.map((p: string) => <li class="flex items-start gap-2.5 text-[15px]"><span class="mt-[7px] h-2 w-2 shrink-0 rounded-full bg-brand2"></span>{p}</li>)}</ul>
                </div>
              </div>
              {v.nota && <p class="mt-5 flex items-start gap-2 bg-surface px-4 py-3 text-[14px] leading-relaxed text-muted"><Icona nome="scudo" class="mt-0.5 h-4 w-4 shrink-0 text-brand" />{v.nota}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- VISITE ED ESAMI -->
    <section id="come-lavoro" class="bg-brand px-4 py-14 text-white sm:px-8">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-12 lg:items-center">
        <h2 class="font-head text-[1.8rem] font-semibold lg:col-span-3" data-reveal>{x.esami.titolo}</h2>
        <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:col-span-9 lg:grid-cols-4" data-stagger>
          {x.esami.voci.map((e: string) => <li class="flex items-start gap-2.5 text-[15px] text-white/90"><span class="mt-[7px] h-2 w-2 shrink-0 rounded-full bg-brand2"></span>{e}</li>)}
        </ul>
      </div>
    </section>

    <!-- ANDROLOGIA -->
    <section id="andrologia" class="px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-6 lg:grid-cols-12">
          <h2 class="titolo-sez text-brand lg:col-span-4" data-reveal>{x.andrologia.titolo}</h2>
          <p class="text-[17px] leading-relaxed text-muted lg:col-span-7 lg:col-start-6" data-reveal>{x.andrologia.intro}</p>
        </div>
        <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {x.andrologia.voci.map((a: any) => (
            <div class="border-t border-line pt-5">
              <h3 class="font-head text-[17px] font-semibold text-ink">{a.titolo}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{a.testo}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CHI SONO -->
    <section id="chi-sono" class="bg-deep px-4 py-16 text-white sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <h2 class="titolo-sez" data-reveal>{m.bio.titolo}</h2>
            <blockquote class="mt-8 border-l-2 border-brand2 pl-6 font-head text-[1.45rem] font-light leading-snug text-white sm:text-[1.75rem]" data-reveal>{x.bio.citazione}</blockquote>
            <p class="mt-4 pl-6 text-[14px] text-deep-ink/60">{nomeCompleto(m)}</p>
          </div>
          <div class="lg:col-span-6">
            <div class="flex items-center gap-5">
              <img src={foto.curriculum} alt={`${nomeCompleto(m)} in camice`} width="249" height="300" loading="lazy" class="h-28 w-24 rounded-[3px] object-cover" />
              <p class="font-head text-[15px] leading-relaxed text-deep-ink/80">{m.specialita}<br />Master universitario di II livello in Andrologia</p>
            </div>
            <div class="mt-6 space-y-4 text-[16px] leading-relaxed text-deep-ink/85">{m.bio.paragrafi.map((p: string) => <p>{p}</p>)}</div>
          </div>
        </div>
        <ol class="mt-16 grid gap-8 border-t border-white/15 pt-10 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          {m.bio.tappe.map((t: any) => (
            <li class="relative pl-6">
              <span class="absolute left-0 top-2 h-2.5 w-2.5 rounded-full bg-brand2" aria-hidden="true"></span>
              <p class="font-head text-xl font-semibold text-brand2">{t.periodo}</p>
              <p class="mt-2 text-[14px] leading-relaxed text-deep-ink/75">{t.testo}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- RECENSIONI -->
    <section id="recensioni" class="px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="titolo-sez text-brand" data-reveal>{m.recensioni.titolo}</h2>
          <p class="max-w-md text-muted" data-reveal>{m.recensioni.nota}</p>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-12">
          <figure class="flex flex-col justify-between rounded-[4px] bg-surface p-7 sm:p-10 lg:col-span-6" data-reveal>
            <blockquote class="font-head text-[1.3rem] font-light leading-relaxed text-ink sm:text-[1.5rem]">“{rec[0].testo}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3 text-[14px] text-muted"><span class="h-2.5 w-2.5 rounded-full bg-brand2"></span><span class="font-semibold text-ink">{rec[0].nome}</span> · {rec[0].data} · MioDottore</figcaption>
          </figure>
          <div class="grid gap-6 sm:grid-cols-2 lg:col-span-6" data-stagger>
            {rec.slice(1).map((r) => (
              <figure class="flex flex-col rounded-[4px] border border-line p-6">
                <blockquote class="flex-1 text-[15px] leading-relaxed text-ink/85">“{r.testo}”</blockquote>
                <figcaption class="mt-4 text-[13px] text-muted"><span class="font-semibold text-ink">{r.nome}</span> · {r.data}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="stile-interventi bg-surface"><PrenotaCalendario m={m} /></div>

    <!-- ARTICOLO + INSTAGRAM -->
    <section id="articoli" class="px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <h2 class="titolo-sez text-brand" data-reveal>Articoli</h2>
        <a href={`/${m.slug}/articolo`} class="group mt-8 grid items-stretch overflow-hidden rounded-[4px] border border-line md:grid-cols-12" data-reveal>
          <img src={m.articolo.img} alt="" width="1500" height="843" loading="lazy" class="aspect-[16/10] h-full w-full object-cover md:col-span-6" />
          <span class="block p-6 sm:p-10 md:col-span-6">
            <span class="font-head text-[12px] font-semibold uppercase tracking-[0.18em] text-brand2">{m.articolo.categoria} · {m.articolo.tempoLettura}</span>
            <span class="mt-3 block font-head text-[1.7rem] font-semibold leading-tight text-brand group-hover:underline">{m.articolo.titolo}</span>
            <span class="mt-4 block text-muted">{m.articolo.intro}</span>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-brand">Legga l'articolo <Icona nome="freccia" class="h-4 w-4" /></span>
          </span>
        </a>

        <div class="mt-20 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <h2 class="titolo-sez text-brand" data-reveal>Dal mio profilo Instagram</h2>
          <p class="inline-flex w-fit items-center gap-2 rounded-[3px] bg-surface px-3 py-1.5 text-xs text-muted"><img src="/pragma-logo-sm.png" alt="" width="14" height="14" class="h-3.5 w-3.5" /> Proposta Pragma: il profilo oggi non esiste</p>
        </div>
        <div class="-mx-4 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-3 lg:overflow-visible" data-stagger>
          {ig.post.map((p: any) => (
            <article class="w-[84%] shrink-0 snap-center overflow-hidden rounded-[4px] border border-line bg-white sm:w-[60%] lg:w-auto">
              <header class="flex items-center gap-3 px-4 py-3"><img src={m.brand.marchio} alt="" width="32" height="32" class="h-8 w-8 rounded-full border border-line bg-white object-contain p-0.5" /><span class="text-sm font-semibold">{ig.handle}</span></header>
              {p.stile === 'lista' && (
                <div class="flex aspect-square flex-col justify-center bg-brand p-7 text-white">
                  <span class="h-3 w-3 rounded-full bg-brand2"></span>
                  <p class="mt-4 font-head text-[1.6rem] font-semibold leading-[1.15]">{p.titolo}</p>
                  <ul class="mt-5 space-y-2">{p.punti.map((t: string) => <li class="flex items-start gap-2 text-[15px] text-white/90"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand2"></span>{t}</li>)}</ul>
                </div>
              )}
              {p.stile === 'foto' && (
                <div class="relative aspect-square overflow-hidden">
                  <img src={foto[p.immagine]} alt="" width="1200" height="900" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                  <div class="absolute inset-x-0 bottom-0 bg-white px-5 py-4"><p class="font-head text-xl font-semibold leading-tight text-brand">{p.titolo}</p><p class="mt-0.5 text-sm text-muted">{p.sottotitolo}</p></div>
                </div>
              )}
              {p.stile === 'domanda' && (
                <div class="flex aspect-square flex-col justify-between bg-brand2 p-7 text-deep">
                  <img src={m.brand.logoScuro} alt="" width="192" height="66" class="h-9 w-auto self-start" />
                  <div><p class="font-head text-[1.7rem] font-semibold leading-[1.12]">{p.titolo}</p><p class="mt-4 w-fit rounded-[3px] bg-deep px-3 py-2 text-[14px] font-semibold text-white">{p.risposta}</p></div>
                </div>
              )}
              <p class="px-4 py-4 text-[13px] leading-relaxed text-ink/80"><span class="font-semibold">{ig.handle}</span> {p.didascalia} <span class="text-brand">{p.hashtag}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SEDI -->
    <section id="sedi" class="bg-surface px-4 py-16 sm:px-8 sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="titolo-sez text-brand" data-reveal>{m.sedi.titolo}</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2" data-stagger>
            {luoghi.map((l) => (
              <div class="flex flex-col rounded-[4px] border border-line bg-white p-6">
                <p class="font-head text-[12px] font-semibold uppercase tracking-[0.16em] text-brand2">{l.tipo}</p>
                <p class="mt-2 font-head text-lg font-semibold text-brand">{l.nome}</p>
                <p class="mt-1 text-[15px] text-muted">{l.indirizzo}, {l.citta}</p>
                {l.telefoni.map((t: any) => <a href={telHref(t.numero)} class="mt-4 inline-flex items-center gap-2 font-semibold hover:text-brand"><Icona nome="tel" class="h-4 w-4 text-brand" />{t.numero}</a>)}
                <a href={mapsHref(l.indirizzo, l.citta)} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-2 pt-4 text-sm font-semibold text-brand hover:underline"><Icona nome="pin" class="h-4 w-4" /> Apra la mappa</a>
              </div>
            ))}
          </div>
          {m.sedi.email && <p class="mt-6 flex flex-wrap items-center gap-2 text-[15px]"><Icona nome="mail" class="h-5 w-5 text-brand" /> Può scrivermi a <a href={`mailto:${m.sedi.email}`} class="font-semibold text-brand hover:underline">{m.sedi.email}</a></p>}
        </div>
        <div class="lg:col-span-5">
          <p class="font-head text-[1.4rem] font-semibold text-brand lg:mt-[4.2rem]">{x.sedi.struttureLabel}</p>
          <ul class="mt-6 space-y-5">
            {x.sedi.strutture.map((s: any) => (
              <li class="flex items-start gap-4 border-b border-line pb-5"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-brand"><Icona nome="ospedale" class="h-5 w-5" /></span><span><span class="block font-head font-semibold">{s.nome}</span><span class="block text-[14px] text-muted">{s.indirizzo}, {s.citta}</span><span class="mt-1 block text-[14px] text-ink/75">{s.testo}</span></span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-brand px-4 py-14 text-white sm:px-8" data-cta-finale>
      <div class="mx-auto flex max-w-7xl flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div><h2 class="font-head text-3xl font-semibold">{m.prenota.titolo}</h2><p class="mt-2 max-w-xl text-white/80">{m.prenota.testo}</p></div>
        <div class="flex shrink-0 flex-col gap-3 whitespace-nowrap sm:flex-row">
          <a href={telHref(m.prenota.telefono)} class="btn !rounded-[3px] bg-white text-brand hover:bg-white/90"><Icona nome="tel" /> {m.prenota.telefonoLabel}</a>
          <a href="#prenota" class="btn !rounded-[3px] bg-brand2 text-deep hover:opacity-90"><Icona nome="calendario" /> Scelga giorno e orario</a>
        </div>
      </div>
    </section>
  </main>

  <Footer m={m} />
  <CtaMobile m={m} />
  <script>
    import '../scripts/motion.ts';
    // Riepilogo della prenotazione rapida: si aggiorna a ogni scelta
    const b = document.querySelector<HTMLElement>('[data-booking]');
    const r = b?.querySelector<HTMLElement>('[data-riepilogo]');
    const aggiorna = () => {
      if (!b || !r) return;
      const mo = b.querySelector<HTMLElement>('[data-chip="motivo"][aria-pressed="true"]')?.dataset.frase;
      const se = b.querySelector<HTMLElement>('[data-chip="sede"][aria-pressed="true"]')?.dataset.frase;
      b.querySelectorAll<HTMLElement>('[role="radio"]').forEach((x) => x.setAttribute('aria-checked', x.getAttribute('aria-pressed') ?? 'false'));
      r.textContent = `Visita per ${mo}, presso ${se}.`;
    };
    b?.querySelectorAll('[data-chip]').forEach((c) => c.addEventListener('click', aggiorna));
  </script>
</Base>

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  tema?: {
    palette: Record<string, string>;
    fontUrl: string;
    fontTitoli: string;
    fontTesti: string;
    favicon?: string;
  };
  banner?: boolean;
}
const { title, description = '', tema, banner = true } = Astro.props;

const vars = tema
  ? Object.entries(tema.palette).map(([k, v]) => `--c-${k}:${v}`).join(';') +
    `;--f-head:'${tema.fontTitoli}', system-ui, sans-serif;--f-sans:'${tema.fontTesti}', system-ui, sans-serif`
  : '--c-bg:#F6F5F2;--c-ink:#0E1A2B;--c-muted:#5d6675;--c-brand:#0E1A2B;--c-line:#e3e1dc;--f-sans:system-ui,sans-serif;--f-head:system-ui,sans-serif';
const style = banner ? vars : `${vars};--banner-h:0px`;
---
<!doctype html>
<html lang="it" style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {tema && <meta name="theme-color" content={tema.palette.bg} />}
    {tema?.favicon ? <link rel="icon" href={tema.favicon} /> : <link rel="icon" href="/pragma-logo.png" />}
    {tema && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={tema.fontUrl} />
      </>
    )}
  </head>
  <body>
    {banner && (
      <div class="fixed inset-x-0 top-0 z-50 flex h-[30px] items-center justify-center bg-ink/95 px-4 text-center text-[11px] tracking-wide text-bg/85 backdrop-blur sm:text-xs">
        Anteprima non ufficiale realizzata da Pragma Solutions
      </div>
    )}
    <slot />
  </body>
</html>

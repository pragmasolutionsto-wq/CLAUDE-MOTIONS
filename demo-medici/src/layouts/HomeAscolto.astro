        <div class="mt-10 grid gap-5 md:grid-cols-3" data-stagger>
          {sedi.map((s) => (
            <article class="flex flex-col rounded-[2rem] bg-white p-7">
              <img src={`/${m.slug}/img/tessera-${s.tessera}.png`} alt="" width="250" height="258" class="h-14 w-14" />
              <h3 class="mt-5 font-head text-[1.5rem] font-semibold leading-tight">{s.nome}</h3>
              <p class="mt-1 text-[16px] text-muted">{s.indirizzo}, {s.citta}</p>
              {s.orari && <p class="mt-3 text-[14px] text-ink/75">{s.orari}</p>}
              <ul class="mt-4 space-y-2">{s.telefoni.map((t: any) => <li><a href={telHref(t.numero)} class="flex items-center gap-2 font-head font-semibold text-brand hover:underline"><Icona nome="tel" class="h-4 w-4" />{t.numero}</a><span class="ml-6 block text-[13px] text-muted">{t.label}</span></li>)}</ul>
              {!s.telefoni.length && <p class="mt-4 text-[14px] text-ink/75">Per informazioni: <a href={`mailto:${m.sedi.email}`} class="font-semibold text-brand hover:underline">{m.sedi.email}</a></p>}
              <a href={mapsHref(s.indirizzo, s.citta)} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-brand hover:underline"><Icona nome="pin" class="h-4 w-4" /> Apra la mappa</a>
            </article>
          ))}
        </div>
        <p class="mt-6 text-[16px]">Scriva a <a href={`mailto:${m.sedi.email}`} class="font-semibold text-brand hover:underline">{m.sedi.email}</a>. Cerchiamo di dare appuntamenti in tempi brevi a chi ha bisogno di un consulto urgente.</p>
      </div>

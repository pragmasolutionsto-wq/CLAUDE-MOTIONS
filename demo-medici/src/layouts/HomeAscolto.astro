    <section class="bg-brand px-4 py-14 text-white sm:px-8">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex items-center gap-5"><img src={foto.logo} alt="" width="512" height="515" class="hidden h-20 w-20 rounded-2xl bg-white p-1 sm:block" /><div><h2 class="font-head text-[2.2rem] font-semibold sm:text-5xl">{m.prenota.titolo}</h2><p class="mt-2 max-w-xl text-white/85">{m.prenota.testo}</p></div></div>
        <div class="flex shrink-0 flex-col gap-3 whitespace-nowrap sm:flex-row">
          <a href={telHref(m.prenota.telefono)} class="btn !rounded-2xl bg-brand2 font-head text-deep hover:opacity-90"><Icona nome="tel" /> {m.prenota.telefonoLabel}</a>
          <a href="#prenota" class="btn !rounded-2xl border border-white/50 font-head text-white hover:bg-white/10"><Icona nome="calendario" /> Scelga giorno e orario</a>
        </div>
      </div>
    </section>
  </main>

  <Footer m={m} />
  <CtaMobile m={m} />
  <script>
    import '../scripts/motion.ts';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';
    gsap.registerPlugin(ScrollTrigger);
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.toggle('senza-moto', ridotto);
    let lenis: Lenis | null = null;
    const vaiA = (sel: string) => { const el = document.querySelector<HTMLElement>(sel)!; if (lenis) lenis.scrollTo(el, { offset: -110 }); else el.scrollIntoView({ behavior: 'auto', block: 'start' }); };

    // --- Prenotazione in tre passi ---
    const box = document.querySelector<HTMLElement>('[data-prenota-box]')!;
    const premuto = (sel: string) => box.querySelector<HTMLElement>(`${sel}[aria-pressed="true"]`)!;
    const aggiorna = () => {
      const g = premuto('[data-gruppo]').dataset.gruppo!;
      const mo = box.querySelector<HTMLElement>(`[data-motivi-gruppo="${g}"] [data-chip="motivo"][aria-pressed="true"]`)!;
      const s = premuto('[data-chip="sede"]');
      const t = `Buongiorno Dottore, vorrei prenotare una visita per ${mo.dataset.frase} presso ${s.dataset.frase}.`;
      box.querySelector<HTMLAnchorElement>('[data-prenota]')!.href = `mailto:${box.dataset.mail}?subject=${encodeURIComponent(box.dataset.oggetto!)}&body=${encodeURIComponent(t)}`;
      box.querySelector('[data-anteprima]')!.textContent = t;
      box.querySelector('[data-indirizzo-testo]')!.textContent = s.dataset.indirizzo!;
      box.querySelector<HTMLAnchorElement>('[data-tel-link]')!.href = `tel:${s.dataset.tel!.replace(/[^\d+]/g, '')}`;
      box.querySelector('[data-tel-testo]')!.textContent = s.dataset.tel!;
      if (!ridotto) gsap.fromTo('[data-anteprima]', { opacity: 0.3, y: 6 }, { opacity: 1, y: 0, duration: 0.3 });
    };
    const scegliGruppo = (id: string) => {
      box.querySelectorAll<HTMLElement>('[data-gruppo]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.gruppo === id)));
      box.querySelectorAll<HTMLElement>('[data-motivi-gruppo]').forEach((c) => {
        const on = c.dataset.motiviGruppo === id; c.classList.toggle('hidden', !on);
        if (on && !c.querySelector('[aria-pressed="true"]')) c.querySelector('[data-chip="motivo"]')!.setAttribute('aria-pressed', 'true');
        if (on && !ridotto) gsap.from(c.children, { y: 10, opacity: 0, duration: 0.3, stagger: 0.04 });
      });
      aggiorna();
    };
    box.querySelectorAll<HTMLElement>('[data-gruppo]').forEach((b) => b.addEventListener('click', () => {
      scegliGruppo(b.dataset.gruppo!);
      if (!ridotto) gsap.fromTo(b.querySelector('img, span'), { rotateY: 0 }, { rotateY: 360, duration: 0.6, ease: 'power2.out' });
    }));
    box.querySelectorAll<HTMLElement>('[data-motivi-gruppo]').forEach((c) => c.querySelectorAll<HTMLElement>('[data-chip="motivo"]').forEach((b) => b.addEventListener('click', () => {
      c.querySelectorAll('[data-chip="motivo"]').forEach((k) => k.setAttribute('aria-pressed', String(k === b))); aggiorna();
    })));
    box.querySelectorAll<HTMLElement>('[data-chip="sede"]').forEach((b) => b.addEventListener('click', () => {
      box.querySelectorAll('[data-chip="sede"]').forEach((k) => k.setAttribute('aria-pressed', String(k === b))); aggiorna();
    }));
    // dai link "Prenoti per...": sceglie il gruppo (ed eventualmente il motivo) e porta al box
    const prenotaPer = (gruppo: string, frase?: string) => {
      scegliGruppo(gruppo);
      if (frase) { const c = box.querySelector(`[data-motivi-gruppo="${gruppo}"]`)!; c.querySelectorAll<HTMLElement>('[data-chip="motivo"]').forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.frase === frase))); aggiorna(); }
      vaiA('#prenota-box');
      box.querySelector<HTMLElement>(`[data-gruppo="${gruppo}"]`)!.focus({ preventScroll: true });
    };
    document.querySelectorAll<HTMLElement>('[data-vai-gruppo]').forEach((b) => b.addEventListener('click', () => prenotaPer(b.dataset.vaiGruppo!)));

    // --- Cosa facciamo: schede ---
    const etab = [...document.querySelectorAll<HTMLElement>('[data-esplora-tab]')];
    const epan = [...document.querySelectorAll<HTMLElement>('[data-esplora-pan]')];
    let eAtt = 0;
    const esplora = (i: number, focus = false) => {
      etab.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      epan.forEach((p, k) => { p.hidden = k !== i; });
      if (!ridotto) gsap.from(epan[i].querySelectorAll('[data-esplora-col], li'), { y: 18, opacity: 0, duration: 0.45, stagger: 0.04, ease: 'power3.out' });
      if (focus) etab[i].focus();
      eAtt = i;
    };
    etab.forEach((t, i) => {
      t.addEventListener('click', () => esplora(i));
      t.addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key; const n = etab.length; if (k === 'ArrowRight') { e.preventDefault(); esplora((eAtt + 1) % n, true); } if (k === 'ArrowLeft') { e.preventDefault(); esplora((eAtt + n - 1) % n, true); } });
    });

    // --- Ascolti le frequenze ---
    const ud = document.querySelector<HTMLElement>('[data-udito]')!;
    const fq = JSON.parse(ud.dataset.frequenze!) as { hz: number; nome: string; testo: string }[];
    const AW = 560, PL = 46, PR = 16;
    const fx = (hz: number) => PL + ((Math.log2(hz) - Math.log2(125)) / (Math.log2(8000) - Math.log2(125))) * (AW - PL - PR);
    const col = ud.querySelector<SVGRectElement>('[data-colonna]')!;
    const onda = ud.querySelector<SVGPathElement>('[data-onda]')!;
    const vol = ud.querySelector<HTMLInputElement>('[data-volume]')!;
    let ctx: AudioContext | null = null, osc: OscillatorNode | null = null, raf = 0, hzAtt = 0, t0 = 0;
    const disegna = (now: number) => {
      // onda reale della frequenza scelta: più è acuta, più le creste sono fitte (scala logaritmica per renderla leggibile)
      const cicli = 1.5 * Math.pow(2, Math.log2(hzAtt / 125));
      const amp = 18 + (Number(vol.value) / 100) * 22, y0 = 52, w = AW - PL - PR;
      const fase = ridotto ? 0 : ((now - t0) / 1000) * 2;
      let d = '';
      for (let i = 0; i <= 220; i++) { const xx = PL + (i / 220) * w; const yy = y0 + Math.sin((i / 220) * cicli * Math.PI * 2 - fase * Math.PI) * amp * Math.min(1, (now - t0) / 300 || 1); d += `${i ? 'L' : 'M'}${xx.toFixed(1)},${yy.toFixed(1)}`; }
      onda.setAttribute('d', d);
      if (!ridotto && now - t0 < 1400) raf = requestAnimationFrame(disegna);
    };
    const suona = (i: number) => {
      const f = fq[i];
      ud.querySelectorAll<HTMLElement>('[data-freq]').forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
      ud.querySelector('[data-freq-testo]')!.textContent = `${f.nome}: ${f.testo}`;
      col.setAttribute('x', String(fx(f.hz) - 22));
      if (ridotto) col.setAttribute('opacity', '0.25'); else gsap.fromTo(col, { attr: { opacity: 0 } }, { attr: { opacity: 0.25 }, duration: 0.4 });
      hzAtt = f.hz; t0 = performance.now(); cancelAnimationFrame(raf); disegna(t0);
      try {
        ctx = ctx ?? new AudioContext();
        if (osc) { try { osc.stop(); } catch {} }
        const g = ctx.createGain(); osc = ctx.createOscillator();
        osc.type = 'sine'; osc.frequency.value = f.hz;
        const v = (Number(vol.value) / 100) * 0.12, t = ctx.currentTime;
        g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(v, t + 0.06); g.gain.setValueAtTime(v, t + 1.0); g.gain.linearRampToValueAtTime(0, t + 1.2);
        osc.connect(g).connect(ctx.destination); osc.start(t); osc.stop(t + 1.25);
        ud.dataset.ultimo = String(f.hz);
      } catch { /* audio non disponibile: resta la parte visiva */ }
    };
    ud.querySelectorAll<HTMLElement>('[data-freq]').forEach((b, i) => b.addEventListener('click', () => suona(i)));

    // --- Esami: il pannello fisso segue il blocco attivo ---
    const eImg = [...document.querySelectorAll<HTMLElement>('[data-esame-img]')];
    const ePunti = [...document.querySelectorAll<HTMLElement>('[data-esame-punto]')];
    const mostraEsame = (i: number) => {
      if (ridotto) eImg.forEach((im, k) => { im.style.opacity = k === i ? '1' : '0'; });
      else gsap.to(eImg, { opacity: (k) => (k === i ? 1 : 0), duration: 0.6 });
      ePunti.forEach((p, k) => { p.classList.toggle('w-8', k === i); p.classList.toggle('w-2.5', k !== i); p.classList.toggle('opacity-60', k !== i); });
      document.querySelector<HTMLElement>('[data-esami]')!.dataset.attivo = String(i);
    };
    document.querySelectorAll<HTMLElement>('[data-esame]').forEach((b, i) => ScrollTrigger.create({ trigger: b, start: 'top 55%', end: 'bottom 55%', onToggle: (s) => { if (s.isActive) mostraEsame(i); } }));

    // --- Scala di Epworth ---
    const ep = document.querySelector<HTMLElement>('[data-epworth]')!;
    const esito = document.querySelector<HTMLElement>('[data-epworth-esito]')!;
    const calcola = () => {
      const scelti = [...ep.querySelectorAll<HTMLInputElement>('input:checked')];
      const tot = scelti.reduce((a, i) => a + Number(i.value), 0), n = scelti.length;
      esito.querySelector('[data-epworth-totale]')!.textContent = String(tot);
      esito.querySelector('[data-epworth-risposte]')!.textContent = String(n);
      const barra = esito.querySelector<HTMLElement>('[data-epworth-barra]')!;
      if (ridotto) barra.style.width = `${(tot / 24) * 100}%`; else gsap.to(barra, { width: `${(tot / 24) * 100}%`, duration: 0.4 });
      barra.classList.toggle('!bg-[#C8323C]', tot > 10);
      const [tit, txt] = n < 8 ? [`Mancano ${8 - n} risposte`, 'Il risultato non è una diagnosi: serve a parlarne meglio in visita.']
        : tot <= 10 ? ['Sonnolenza di giorno nella norma', 'Se però russa forte o chi dorme con Lei nota pause nel respiro, vale comunque la pena di parlarne.']
        : tot <= 15 ? ['Sonnolenza di giorno aumentata', 'Un punteggio sopra 10 merita una valutazione: in visita cerchiamo con la fibroscopia dove si ostruisce il respiro.']
        : ['Sonnolenza di giorno elevata', 'Ne parli presto con noi o con il Suo medico: potrebbe servire un monitoraggio del sonno.'];
      esito.querySelector('[data-epworth-titolo]')!.textContent = tit;
      esito.querySelector('[data-epworth-testo]')!.textContent = txt;
      esito.dataset.totale = String(tot);
    };
    ep.addEventListener('change', calcola);
    esito.querySelector('[data-epworth-azzera]')!.addEventListener('click', () => { ep.querySelectorAll<HTMLInputElement>('input').forEach((i) => { i.checked = false; }); calcola(); });
    esito.querySelector('[data-epworth-prenota]')!.addEventListener('click', () => prenotaPer('naso', 'russamento o apnee notturne'));

    if (!ridotto) {
      lenis = new Lenis({ anchors: { offset: -100 }, lerp: 0.1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis!.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);

      const h = document.querySelector<HTMLElement>('[data-titolo-hero]')!;
      const parole = (h.textContent ?? '').trim().split(/\s+/);
      h.setAttribute('aria-label', parole.join(' '));
      h.innerHTML = parole.map((w, i) => `<span class="inline-block overflow-hidden pb-[0.1em] align-bottom" aria-hidden="true"><span class="inline-block ${i >= 4 ? 'text-brand' : ''}">${w}</span></span>`).join(' ');
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.from('[data-tessera-foto]', { rotateY: -80, opacity: 0, transformOrigin: '0% 50%', duration: 1.1, stagger: 0.18, ease: 'power4.out' })
        .from(h.querySelectorAll(':scope > span > span'), { yPercent: 110, duration: 0.8, stagger: 0.05 }, 0.1)
        .from('[data-entra]', { y: 24, opacity: 0, duration: 0.7, stagger: 0.08 }, '-=0.5')
        .from('[data-volante]', { scale: 0, rotate: -40, duration: 0.7, stagger: 0.12, ease: 'back.out(2)' }, 0.6)
        .from('[data-prenota-box] > div', { y: 60, opacity: 0, duration: 0.9 }, 0.5)
        .from('[data-gruppo]', { y: 20, opacity: 0, rotateX: -60, duration: 0.6, stagger: 0.07 }, 0.9);
      gsap.utils.toArray<HTMLElement>('[data-volante]').forEach((el, i) => gsap.to(el, { y: i % 2 ? 10 : -10, rotate: i % 2 ? 4 : -4, duration: 2.6 + i * 0.4, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 1.5 }));
      document.querySelectorAll<HTMLElement>('[data-conta]').forEach((el) => {
        const fine = Number(el.dataset.conta); const o = { v: 0 };
        gsap.to(o, { v: fine, duration: 1.8, delay: 0.8, ease: 'power2.out', onUpdate: () => { el.textContent = Math.round(o.v).toLocaleString('it-IT'); } });
      });
      gsap.to('[data-tessera-foto]', { yPercent: (i) => (i ? -8 : 4), ease: 'none', scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } });
      gsap.utils.toArray<HTMLElement>('[data-sale]').forEach((el) => gsap.from(el, { y: 40, opacity: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } }));
      gsap.from('[data-esplora-tab]', { y: 30, opacity: 0, duration: 0.6, stagger: 0.08, scrollTrigger: { trigger: '[data-esplora-tabs]', start: 'top 88%', once: true } });
      // l'audiogramma si disegna
      const righe = gsap.utils.toArray<SVGLineElement>('[data-riga]');
      righe.forEach((r) => { const l = Math.hypot(+r.getAttribute('x2')! - +r.getAttribute('x1')!, +r.getAttribute('y2')! - +r.getAttribute('y1')!); r.style.strokeDasharray = r.getAttribute('stroke-dasharray') ?? `${l}`; if (!r.getAttribute('stroke-dasharray')) { r.style.strokeDashoffset = `${l}`; } });
      gsap.to(righe.filter((r) => !r.getAttribute('stroke-dasharray')), { strokeDashoffset: 0, duration: 1.2, stagger: 0.03, ease: 'power2.out', scrollTrigger: { trigger: '[data-audiogramma]', start: 'top 80%', once: true } });
      gsap.from('[data-freq]', { y: 20, opacity: 0, duration: 0.5, stagger: 0.06, scrollTrigger: { trigger: '[data-udito]', start: 'top 70%', once: true } });
      gsap.from('[data-epworth-voce]', { x: 40, opacity: 0, duration: 0.6, stagger: 0.06, ease: 'power3.out', scrollTrigger: { trigger: '[data-epworth]', start: 'top 85%', once: true } });
      gsap.from('[data-medici] > article', { y: 60, opacity: 0, rotateX: -12, duration: 0.9, stagger: 0.15, ease: 'power3.out', scrollTrigger: { trigger: '[data-medici]', start: 'top 85%', once: true } });
      gsap.utils.toArray<HTMLElement>('[data-parallasse]').forEach((im) => gsap.fromTo(im, { scale: 1.15, yPercent: -8 }, { scale: 1.15, yPercent: 8, ease: 'none', scrollTrigger: { trigger: im, start: 'top bottom', end: 'bottom top', scrub: true } }));
      gsap.from('[data-blog] > *', { y: 60, opacity: 0, duration: 0.8, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '[data-blog]', start: 'top 85%', once: true } });
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
  </script>
</Base>

          {ig.post.map((p: any) => (
            <article class="w-[84%] shrink-0 snap-center overflow-hidden rounded-3xl border border-line bg-white sm:w-[60%] lg:w-auto">
              <header class="flex items-center gap-3 px-4 py-3"><img src={foto.logo} alt="" width="32" height="32" class="h-8 w-8" /><span class="text-sm font-semibold">{ig.handle}</span></header>

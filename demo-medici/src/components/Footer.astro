---
import Icona from './Icona.astro';
import { nomeCompleto, telHref, type Medico } from '../lib/medici';
interface Props { m: Medico }
const { m } = Astro.props;
const base = `/${m.slug}`;
---
<footer class="bg-deep pb-28 text-sm text-deep-ink/70 sm:pb-10">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 pt-14 sm:px-8 md:grid-cols-12">
    <div class="md:col-span-4">
      {(m.brand as any).header === 'testo'
        ? <p class="font-head text-2xl font-semibold leading-tight text-white">{nomeCompleto(m)}<span class="mt-1 block font-sans text-xs font-normal uppercase tracking-[0.16em] text-deep-ink/60">{m.firma} · {m.citta}</span></p>
        : <img src={m.brand.logoChiaro} alt={m.brand.logoAlt} width="1008" height="189" loading="lazy" class={(m.brand as any).header === 'marchio' ? 'h-24 w-auto' : 'h-10 w-auto'} />}
      <p class="mt-5 max-w-xs leading-relaxed">{m.specialita}, {m.citta}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-head text-[15px] font-semibold text-white">Dove ricevo</p>
      {(m.sedi.luoghi as any[]).filter((l, i, a) => a.some((x) => x.principale) ? l.principale : true).map((l) => <p class="mt-3 leading-relaxed">{l.tipo}<br /><span class="text-deep-ink/90">{l.indirizzo}, {l.citta}</span></p>)}
    </div>
    <div class="md:col-span-3">
      <p class="font-head text-[15px] font-semibold text-white">Contatti</p>
      <p class="mt-3"><a href={telHref(m.prenota.telefono)} class="inline-flex items-center gap-2 hover:text-white"><Icona nome="tel" class="h-4 w-4" />{m.prenota.telefonoLabel}</a></p>
      {m.sedi.email && <p class="mt-2"><a href={`mailto:${m.sedi.email}`} class="inline-flex items-center gap-2 hover:text-white"><Icona nome="mail" class="h-4 w-4 shrink-0" />{m.sedi.email}</a></p>}
    </div>
    <div class="md:col-span-2">
      <p class="font-head text-[15px] font-semibold text-white">Pagine</p>
      <ul class="mt-3 space-y-2">
        <li><a href={`${base}#chi-sono`} class="hover:text-white">Chi sono</a></li>
        <li><a href={`${base}#aree`} class="hover:text-white">Di cosa mi occupo</a></li>
        <li><a href={(m as any).blog ? `${base}/blog` : `${base}/articolo`} class="hover:text-white">{(m as any).blog ? 'Blog' : 'Articoli'}</a></li>
        <li><a href={`${base}#sedi`} class="hover:text-white">Dove ricevo</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-12 max-w-7xl border-t border-white/10 px-5 pt-6 text-xs leading-relaxed text-deep-ink/50 sm:px-8">
    <p>© {nomeCompleto(m)} · Le informazioni mediche hanno scopo divulgativo e non sostituiscono la visita.</p>
    <p class="mt-2 flex items-start gap-2"><img src="/pragma-logo-sm.png" alt="" width="16" height="16" class="mt-0.5 h-4 w-4" /><span>Anteprima non ufficiale realizzata da Pragma Solutions, Torino. {m.repertorio}</span></p>
  </div>
</footer>

---
import { nomeCompleto, type Medico } from '../lib/medici';
interface Props { m: Medico }
const { m } = Astro.props;
---
<footer class="bg-deep pb-28 text-deep-ink/70 sm:pb-12">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 pt-12 text-sm sm:px-8 md:flex-row md:items-end md:justify-between">
    <div>
      <img src={m.brand.logoChiaro} alt={m.brand.logoAlt} width="1008" height="189" loading="lazy" class="h-10 w-auto" />
      <p class="mt-5">{m.sedi.luoghi[0].indirizzo}, {m.sedi.luoghi[0].citta}</p>
      <p class="mt-1"><a href={`mailto:${m.sedi.email}`} class="hover:text-deep-ink">{m.sedi.email}</a></p>
    </div>
    <p class="max-w-sm text-xs leading-relaxed text-deep-ink/50 md:text-right">
      {nomeCompleto(m)} · Anteprima non ufficiale realizzata da Pragma Solutions, Torino, a scopo dimostrativo. Le informazioni mediche hanno scopo divulgativo e non sostituiscono la visita.
    </p>
  </div>
</footer>

---
import Icona from './Icona.astro';
import { telHref, type Medico } from '../lib/medici';
interface Props { m: Medico }
const { m } = Astro.props;
---
<section id="contatti" data-cta-finale class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:items-end lg:py-24">
    <div class="lg:col-span-7" data-reveal>
      <p class="label">Appuntamenti</p>
      <h2 class="mt-4 text-4xl font-semibold leading-[1.1] sm:text-5xl">{m.prenota.titolo}</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{m.prenota.testo}</p>
    </div>
    <div class="flex flex-col gap-3 lg:col-span-5" data-reveal>
      <a href={telHref(m.prenota.telefono)} class="btn btn-primary w-full !min-h-[56px] text-lg"><Icona nome="tel" /> {m.prenota.telefonoLabel}</a>
      <a href={`mailto:${m.sedi.email}`} class="btn btn-ghost w-full !min-h-[56px]"><Icona nome="mail" /> {m.sedi.email}</a>
    </div>
  </div>
</section>

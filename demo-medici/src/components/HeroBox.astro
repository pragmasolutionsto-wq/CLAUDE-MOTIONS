---
// Card dell'hero: nome, specialità e box di prenotazione (motivo + sede → WhatsApp o mail già compilati).
import Icona from './Icona.astro';
import { nomeCompleto, telHref, emailRichieste, type Medico } from '../lib/medici';
interface Props { m: Medico; class?: string }
const { m, class: cls = '' } = Astro.props;
const box = m.hero.box;
const luoghi = m.sedi.luoghi as Array<{ tipo: string; indirizzo: string; frase: string; nome?: string }>;
const email = emailRichieste(m);
const msg = (motivo: string, sede: string) => `Buongiorno Dottore, vorrei prenotare una visita per ${motivo} presso ${sede}.`;
const wa = m.prenota.whatsapp ? String(m.prenota.whatsapp).replace(/\D/g, '') : '';
const href = (motivo: string, sede: string) => wa
  ? `https://wa.me/${wa}?text=${encodeURIComponent(msg(motivo, sede))}`
  : `mailto:${email}?subject=${encodeURIComponent(m.prenota.oggettoMail)}&body=${encodeURIComponent(msg(motivo, sede))}`;
const molte = luoghi.length > 2;
---
<div class={`card relative p-5 sm:p-7 ${cls}`}>
  <p class="label">{m.hero.eyebrow}</p>
  <h1 class="mt-2 text-[2.1rem] font-semibold leading-[1.05] sm:text-[2.6rem]">{nomeCompleto(m)}</h1>
  <p class="mt-1.5 text-[17px] text-muted">{m.specialita}</p>

  <div class="mt-4 border-t border-line pt-4" data-booking data-wa={wa} data-email={email} data-oggetto={m.prenota.oggettoMail}>
    <p class="font-head text-lg font-semibold">{box.titolo}</p>
    <p class="mt-3 text-[13px] font-semibold uppercase tracking-wide text-muted">{box.motivoLabel}</p>
    <div class="mt-2 flex flex-wrap gap-2" role="group">
      {box.motivi.map((x, i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-chip="motivo" data-frase={box.motiviFrase[i]}>{x}</button>)}
    </div>
    <p class="mt-4 text-[13px] font-semibold uppercase tracking-wide text-muted">{box.sedeLabel}</p>
    {molte ? (
      <select class="campo mt-2" data-sede-select aria-label={box.sedeLabel}>
        {luoghi.map((l) => <option value={l.frase}>{l.nome ?? l.tipo} · {l.indirizzo}</option>)}
      </select>
    ) : (
      <div class={`mt-2 grid gap-1 rounded-xl bg-surface p-1 ${luoghi.length > 1 ? 'grid-cols-2' : 'grid-cols-1'}`} role="group">
        {luoghi.map((l, i) => (
          <button type="button" data-chip="sede" aria-pressed={i === 0 ? 'true' : 'false'} data-frase={l.frase}
            class="rounded-lg px-3 py-2 text-left text-[13px] leading-tight text-muted aria-pressed:bg-white aria-pressed:text-ink aria-pressed:shadow-sm">
            <span class="block font-semibold">{l.tipo}</span><span class={luoghi.length > 1 ? 'hidden sm:inline' : ''}>{l.indirizzo}{luoghi.length > 1 ? '' : `, ${(l as any).citta ?? ''}`}</span>
          </button>
        ))}
      </div>
    )}
    <a href={href(box.motiviFrase[0], luoghi[0].frase)} data-prenota target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined}
      class="btn btn-primary mt-5 w-full !min-h-[54px] text-lg"><Icona nome={wa ? 'commento' : 'mail'} /> {wa ? 'Invii la richiesta su WhatsApp' : 'Invii la richiesta via mail'}</a>
    <a href={telHref(m.prenota.telefono)} class="mt-3 block text-center text-sm font-semibold text-brand hover:underline">Oppure chiami {m.prenota.chiamaLabel ?? 'la segreteria'}: {m.prenota.telefonoLabel}</a>
  </div>
</div>

---
import Icona from './Icona.astro';
import { telHref, type Medico } from '../lib/medici';
interface Props { m: Medico; home?: boolean }
const { m, home = true } = Astro.props;
const base = `/${m.slug}`;
const link = [
  ['Chi sono', '#chi-sono'], ['Di cosa mi occupo', '#aree'], ['Come lavoro', '#come-lavoro'], ['Articoli', '#articoli'], ['Dove ricevo', '#sedi'],
].map(([t, h]) => [t, home ? h : `${base}${h}`]);
---
<header class="sticky z-30 border-b border-line bg-white/95 backdrop-blur" style="top: var(--banner-h)">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-8">
    <a href={base} class="block shrink-0">
      <img src={m.brand.logoScuro} alt={m.brand.logoAlt} width="766" height="148" class="h-8 w-auto sm:h-10" />
    </a>
    <nav class="hidden items-center gap-6 text-[15px] font-medium text-ink/75 xl:flex">
      {link.map(([t, h]) => <a href={h} class="transition-colors hover:text-brand">{t}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a href={telHref(m.prenota.telefono)} class="hidden items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink hover:border-brand hover:text-brand md:inline-flex">
        <Icona nome="tel" class="h-4 w-4" /> {m.prenota.telefonoLabel}
      </a>
      <a href={telHref(m.prenota.telefono)} class="btn btn-primary !min-h-[42px] !px-4 text-sm">Prenoti</a>
    </div>
  </div>
</header>

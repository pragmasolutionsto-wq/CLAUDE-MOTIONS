---
import { telHref, type Medico } from '../lib/medici';
interface Props { m: Medico; home?: boolean }
const { m, home = true } = Astro.props;
const base = `/${m.slug}`;
const link = [
  ['Chi è', '#chi-e'], ['Di cosa si occupa', '#aree'], ['Articoli', '#articoli'], ['Dove riceve', '#sedi'],
].map(([t, h]) => [t, home ? h : `${base}${h}`]);
---
<header class="relative z-20 border-b border-line bg-bg">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={base} class="block shrink-0">
      <img src={m.brand.logoScuro} alt={m.brand.logoAlt} width="766" height="148" class="h-9 w-auto sm:h-11" />
    </a>
    <nav class="hidden items-center gap-8 text-[15px] text-ink/75 lg:flex">
      {link.map(([t, h]) => <a href={h} class="transition-colors hover:text-brand">{t}</a>)}
    </nav>
    <a href={telHref(m.prenota.telefono)} class="btn btn-primary hidden !min-h-[44px] !px-5 text-[15px] sm:inline-flex">{m.hero.ctaPrenota}</a>
  </div>
</header>

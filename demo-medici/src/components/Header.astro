---
import { nomeCompleto, telHref, type Medico } from '../lib/medici';
interface Props { m: Medico; home?: boolean }
const { m, home = true } = Astro.props;
const base = `/${m.slug}`;
const link = [
  ['Chi è', '#chi-e'], ['Di cosa si occupa', '#aree'], ['Articoli', '#articoli'], ['Dove riceve', '#sedi'],
].map(([t, h]) => [t, home ? h : `${base}${h}`]);
---
<header class="relative z-20 border-b border-line/70">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={base} class="min-w-0">
      <span class="block truncate font-serif text-lg leading-tight sm:text-xl">{nomeCompleto(m)}</span>
      <span class="block truncate text-xs text-muted">{m.specialita}</span>
    </a>
    <nav class="hidden items-center gap-7 text-sm text-ink/80 lg:flex">
      {link.map(([t, h]) => <a href={h} class="transition-colors hover:text-accent">{t}</a>)}
    </nav>
    <a href={telHref(m.prenota.telefono)} class="btn btn-primary shrink-0 !min-h-[42px] !px-4 text-sm sm:!px-5">
      <span class="sm:hidden">Prenota</span><span class="hidden sm:inline">{m.hero.cta}</span>
    </a>
  </div>
</header>

---
// Richiesta di prenotazione con calendario (giorno → orario → dati → invio).
// Funziona davvero: l'invio apre WhatsApp (se c'è un numero verificato) o una mail già compilata.
// Gli orari sono indicativi: la conferma la dà la segreteria (scritto in pagina).
import Icona from './Icona.astro';
import { telHref, emailRichieste, type Medico } from '../lib/medici';

interface Props { m: Medico }
const { m } = Astro.props;
const c = m.prenota.calendario;
const box = m.hero.box;
const cfg = {
  giorni: c.giorni, mattina: c.mattina, pomeriggio: c.pomeriggio, settimane: c.settimane,
  wa: m.prenota.whatsapp ? String(m.prenota.whatsapp).replace(/\D/g, '') : '',
  email: emailRichieste(m), oggetto: m.prenota.oggettoMail, saluto: (m.prenota as any).saluto || 'Dottore',
};
---
<section id="prenota" class="py-16 sm:py-24" data-calendario={JSON.stringify(cfg)}>
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <h2 class="titolo-sez" data-reveal>{c.titolo}</h2>
      <p class="max-w-md text-muted" data-reveal>{c.intro}</p>
    </div>

    <!-- passi -->
    <ol class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-2 text-[13px] sm:text-sm font-medium text-muted" data-passi>
      {['Giorno e orario', 'I Suoi dati', 'Invio'].map((t, i) => (
        <li class="flex items-center gap-2" data-passo={i}>
          <span class="grid h-7 w-7 place-items-center rounded-full border border-line bg-white text-xs font-semibold">{i + 1}</span>{t}
          {i < 2 && <Icona nome="dx" class="h-4 w-4 text-line" />}
        </li>
      ))}
    </ol>

    <div class="mt-6 grid gap-5 lg:grid-cols-12">
      <!-- CALENDARIO -->
      <div class="card p-4 sm:p-6 lg:col-span-7">
        <div class="flex items-center justify-between">
          <p class="font-head text-xl font-semibold capitalize" data-mese aria-live="polite">&nbsp;</p>
          <div class="flex gap-2">
            <button type="button" data-mese-prec class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white hover:border-brand hover:text-brand disabled:opacity-30 disabled:hover:border-line disabled:hover:text-ink" aria-label="Mese precedente"><Icona nome="sx" /></button>
            <button type="button" data-mese-succ class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white hover:border-brand hover:text-brand disabled:opacity-30 disabled:hover:border-line disabled:hover:text-ink" aria-label="Mese successivo"><Icona nome="dx" /></button>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-7 text-center text-xs font-semibold uppercase tracking-wide text-muted">
          {['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'].map((g) => <span class="py-2">{g}</span>)}
        </div>
        <div class="grid grid-cols-7 gap-1 sm:gap-1.5" data-griglia role="grid"></div>

        <div class="mt-5 border-t border-line pt-5">
          <p class="font-head text-[17px] font-semibold" data-giorno-titolo>Scelga un giorno nel calendario</p>
          <div data-orari class="mt-3 hidden">
            {c.mattina.length > 0 && <p class="mb-2 text-[13px] font-semibold uppercase tracking-wide text-muted">Mattina</p>}
            {c.mattina.length > 0 && <div class="mb-4 grid grid-cols-4 gap-2 sm:grid-cols-7" data-slot="mattina"></div>}
            {c.pomeriggio.length > 0 && <p class="mb-2 text-[13px] font-semibold uppercase tracking-wide text-muted">Pomeriggio</p>}
            {c.pomeriggio.length > 0 && <div class="grid grid-cols-4 gap-2 sm:grid-cols-7" data-slot="pomeriggio"></div>}
          </div>
          <p class="mt-4 flex items-start gap-2 text-[13px] text-muted"><Icona nome="calendario" class="mt-0.5 h-4 w-4 shrink-0" />{c.notaOrari}</p>
        </div>
      </div>

      <!-- DATI E INVIO -->
      <form class="card flex flex-col p-4 sm:p-6 lg:col-span-5" data-form novalidate>
        <div class="rounded-xl bg-surface p-4" data-riepilogo>
          <p class="text-[13px] font-semibold uppercase tracking-wide text-muted">Appuntamento richiesto</p>
          <p class="mt-1 font-head text-lg font-semibold" data-riep-data>Nessun orario scelto</p>
        </div>

        <div class="mt-4 grid gap-3">
          <label class="block text-sm font-medium">Motivo della visita
            <select name="motivo" class="campo mt-1">
              {((c as any).motivi ?? box.motivi).map((x: string, i: number) => <option value={((c as any).motiviFrase ?? box.motiviFrase)[i]}>{x}</option>)}
            </select>
          </label>
          <label class="block text-sm font-medium">Sede
            <select name="sede" class="campo mt-1">
              {((c as any).luoghi ?? m.sedi.luoghi.map((l) => ({ nome: l.indirizzo, frase: l.frase }))).map((l: any) => <option value={l.frase}>{l.nome}</option>)}
            </select>
          </label>
        </div>

        <fieldset class="mt-3">
          <legend class="text-sm font-medium">Tipo di visita</legend>
          <div class="mt-1 grid grid-cols-2 gap-1 rounded-xl bg-surface p-1">
            {c.tipi.map((t, i) => (
              <label class="cursor-pointer rounded-lg px-3 py-2 text-center text-sm text-muted has-[:checked]:bg-white has-[:checked]:font-semibold has-[:checked]:text-ink has-[:checked]:shadow-sm">
                <input type="radio" name="tipo" value={t} checked={i === 0} class="sr-only" />{t}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="block text-sm font-medium">Nome e cognome *
            <input name="nome" type="text" autocomplete="name" class="campo mt-1" required />
          </label>
          <label class="block text-sm font-medium">Telefono *
            <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" class="campo mt-1" required />
          </label>
        </div>
        <label class="mt-3 block text-sm font-medium">Email
          <input name="email" type="email" autocomplete="email" class="campo mt-1" />
        </label>
        <label class="mt-3 block text-sm font-medium">Note per il medico
          <textarea name="note" rows="2" class="campo mt-1 resize-none" placeholder={(c as any).notePlaceholder ?? 'Per esempio da quanto tempo ha dolore, esami già fatti'}></textarea>
        </label>
        <label class="mt-3 flex items-start gap-2 text-[13px] leading-snug text-muted">
          <input name="privacy" type="checkbox" class="mt-0.5 h-4 w-4 accent-[var(--c-brand)]" required />
          <span>Ho letto l'{c.privacy
            ? <a href={c.privacy} target="_blank" rel="noopener" class="font-semibold text-brand underline-offset-2 hover:underline">informativa privacy</a>
            : <button type="button" data-privacy-apri aria-expanded="false" aria-controls="privacy-nota" class="font-semibold text-brand underline-offset-2 hover:underline">informativa privacy</button>} e acconsento al trattamento dei miei dati per la gestione della richiesta. *</span>
        </label>
        {!c.privacy && (c as any).privacyTesto && <p id="privacy-nota" class="mt-2 hidden rounded-lg bg-surface px-3 py-2 text-[13px] leading-snug text-muted" data-privacy-nota>{(c as any).privacyTesto}</p>}

        <p class="mt-3 hidden rounded-lg bg-[#FDECEC] px-3 py-2 text-sm text-[#A12828]" data-errore role="alert"></p>

        <button type="submit" class="btn btn-primary mt-4 w-full !min-h-[54px] text-lg">
          <Icona nome={cfg.wa ? 'commento' : 'mail'} /> {cfg.wa ? 'Invii la richiesta su WhatsApp' : 'Invii la richiesta'}
        </button>
        <a href="#" data-invio class="hidden" aria-hidden="true" tabindex="-1">invio</a>

        <div class="mt-4 hidden rounded-xl border border-brand2/40 bg-brand2/10 p-4 text-sm leading-relaxed" data-fatto role="status">
          <p class="flex items-center gap-2 font-head text-base font-semibold text-ink"><Icona nome="check" class="h-5 w-5 text-brand" /> Richiesta pronta</p>
          <p class="mt-1 text-ink/80">Si è aperta la Sua {cfg.wa ? 'app WhatsApp' : 'app di posta'} con il messaggio già compilato: le basta premere invia. Se non si apre, chiami {m.prenota.chiamaLabel ?? 'la segreteria'} allo <a href={telHref(m.prenota.telefono)} class="font-semibold text-brand">{m.prenota.telefonoLabel}</a>.</p>
        </div>
        {(m.prenota as any).notaRichieste && <p class="mt-3 flex items-start justify-center gap-1.5 text-center text-xs text-muted"><img src="/pragma-logo-sm.png" alt="" width="14" height="14" class="mt-px h-3.5 w-3.5" />{(m.prenota as any).notaRichieste}</p>}
        <p class="mt-3 text-center text-xs text-muted">* Campi obbligatori. La prenotazione è confermata solo dopo il contatto {m.prenota.chiamaLabel === 'lo studio' ? 'dello studio' : 'della segreteria'}.</p>
      </form>
    </div>
  </div>
</section>

<script>import '../scripts/calendario.ts';</script>

---
// Segnaposto elegante al posto della foto del medico (mai foto prese dal web).
interface Props { iniziali: string; class?: string }
const { iniziali, class: cls = '' } = Astro.props;
---
<figure class={`relative overflow-hidden rounded-[28px] bg-deep text-deep-ink ${cls}`}>
  <svg class="absolute inset-0 h-full w-full opacity-[.18]" aria-hidden="true">
    <defs>
      <pattern id="righe" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
        <line x1="0" y1="0" x2="0" y2="14" stroke="currentColor" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#righe)" />
  </svg>
  <div class="absolute -bottom-16 -right-16 h-56 w-56 rounded-full bg-accent opacity-70"></div>
  <div class="relative flex h-full flex-col justify-between p-7">
    <span class="font-serif text-7xl leading-none sm:text-8xl">{iniziali}</span>
    <figcaption class="text-xs uppercase tracking-[0.2em] text-deep-ink/70">Foto del dottore</figcaption>
  </div>
</figure>

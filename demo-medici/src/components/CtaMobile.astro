---
import Icona from './Icona.astro';
import { telHref, type Medico } from '../lib/medici';
interface Props { m: Medico }
const { m } = Astro.props;
---
<div data-mobile-cta class="cta-mobile fixed inset-x-0 bottom-0 z-40 p-3 lg:hidden" style="padding-bottom:max(.75rem, env(safe-area-inset-bottom))">
  <a href={telHref(m.prenota.telefono)} class="btn btn-primary w-full shadow-2xl">
    <Icona nome="tel" /> {m.hero.cta}
  </a>
</div>
<style>
  .cta-mobile { transform: translateY(120%); transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .cta-mobile:global(.is-on) { transform: translateY(0); }
</style>

 "cues": [
  {
   "text": "Anche tu hai sperimentato la difficoltà a trovare",
   "t": 0.09,
   "te": 3.04
  },
  {
   "text": "un nuovo farmacista collaboratore?",
   "t": 3.04,
   "te": 5.05
  },
  {
   "text": "Il 10 settembre ho tenuto una lezione di",
   "t": 5.28,
   "te": 7.756
  },
  {
   "text": "comunicazione all’Università di Bari, a un’aula",
   "t": 7.756,
   "te": 11.106
  },
  {
   "text": "di ragazzi laureandi in CTF e farmacia, e",
   "t": 11.106,
   "te": 14.996
  },
  {
   "text": "ho fatto loro questa domanda.",
   "t": 14.996,
   "te": 16.4
  },
  {
   "text": "Chi di voi vuole lavorare in farmacia?",
   "t": 16.62,
   "te": 18.64
  },
  {
   "text": "Nessuno ha alzato la mano.",
   "t": 19.54,
   "te": 21.63
  },
  {
   "text": "Non è la prima volta, la faccio da",
   "t": 22.32,
   "te": 24.555
  },
  {
   "text": "anni questa domanda, e ogni anno le mani",
   "t": 24.555,
   "te": 27.955
  },
  {
   "text": "che si alzano sono sempre di meno.",
   "t": 27.955,
   "te": 29.81
  },
  {
   "text": "Dipende solo dai ragazzi?",
   "t": 30.2,
   "te": 31.67
  },
  {
   "text": "O possiamo pensare che dipenda anche da chi",
   "t": 32.03,
   "te": 35.133
  },
  {
   "text": "guida le farmacie oggi?",
   "t": 35.133,
   "te": 36.54
  },
  {
   "text": "I giovani hanno bisogno di un mentore, di",
   "t": 37.33,
   "te": 40.204
  },
  {
   "text": "un faro che illumini il loro percorso e",
   "t": 40.204,
   "te": 42.664
  },
  {
   "text": "che li aiuti a scegliere, in pratica di",
   "t": 42.664,
   "te": 45.484
  },
  {
   "text": "un modello a cui ispirarsi.",
   "t": 45.484,
   "te": 47.17
  },
  {
   "text": "Ma dove sono oggi i modelli a cui",
   "t": 47.4,
   "te": 50.679
  },
  {
   "text": "ispirarsi?",
   "t": 50.679,
   "te": 51.39
  },
  {
   "text": "Perché il posto in cui un giovane farmacista",
   "t": 51.87,
   "te": 54.265
  },
  {
   "text": "sceglie di lavorare e decide di rimanere dipende",
   "t": 54.265,
   "te": 58.405
  },
  {
   "text": "da chi lo guida.",
   "t": 58.405,
   "te": 59.1
  },
  {
   "text": "Il team è solo una parte, il resto",
   "t": 59.49,
   "te": 62.713
  },
  {
   "text": "è imparare a guidare davvero la tua farmacia,",
   "t": 62.713,
   "te": 66.18
  },
  {
   "text": "ma soprattutto te stesso.",
   "t": 66.12,
   "te": 67.85
  },
  {
   "text": "Per questo abbiamo creato da titolare di farmacia",
   "t": 68.36,
   "te": 72.317
  },
  {
   "text": "a leader che ispira a un percorso di",
   "t": 72.317,
   "te": 75.357
  },
  {
   "text": "formazione specifico per farmacisti titolari.",
   "t": 75.357,
   "te": 78.5
  }
 ],
